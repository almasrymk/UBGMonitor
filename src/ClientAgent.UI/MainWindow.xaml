<Window x:Class="ClientAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClientAgent.UI.Views"
        Title="{Binding WindowTitle}"
        Icon="Assets/agent-monitor.png"
        Width="1280"
        Height="780"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundDarkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceDarkBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="─" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="☐" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="18" Height="18" Margin="10,0,8,0"
                           Source="Assets/agent-monitor.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SurfaceDarkBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8,0,8">
                <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" Tag="&#xE80F;" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Dashboard"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource NavButton}" Content="Monitor Points" Tag="&#xE707;" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Monitor Points"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Monitor Points, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="&#xE713;" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Settings"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Settings, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource NavButton}" Content="About" Tag="&#xE946;" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="About"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=About, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceDarkAltBrush}"
                CornerRadius="5"
                Margin="8,6"
                Padding="12,8"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="Auto"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMonitorPoints}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="1.65*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMonitorPoints}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="Auto"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNotifications}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="0.75*"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNotifications}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" MaxWidth="280">
                    <TextBlock Text="Service Status" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="24" Height="24" Margin="0,0,8,0">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE711;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceRunning}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Text="{Binding AgentStatus, StringFormat=Service: {0}}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"
                                       Text="{Binding Settings.MachineName, StringFormat=Device: {0}}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"
                                       Text="{Binding AgentVersion}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Grid Width="24" Height="24" Margin="0,0,8,0">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InternetConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE701;"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="White"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                       Text="&#xE711;">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InternetConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="{Binding InternetStatus}"/>
                    </StackPanel>
                    <Border Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="5" Padding="8,4" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                       Text="{Binding Uptime, StringFormat=Uptime: {0}}"/>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="12,0,0,0"
                                       Text="{Binding Ram.TotalGb, StringFormat=RAM: {0:0.0} GB}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderColorBrush}" Margin="10,2"
                           Visibility="{Binding HasMonitorPoints, Converter={StaticResource BoolToVis}}"/>

                <DockPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Top"
                           Visibility="{Binding HasMonitorPoints, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="Monitor Points" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RepeatButton Grid.Column="0"
                                      Style="{StaticResource MonitorPointNavButton}"
                                      Click="MonitorPointsScrollLeft"
                                      VerticalAlignment="Center">
                            <Path Width="10" Height="16" Stretch="Uniform" Fill="White"
                                  Data="M 12,0 L 0,8 L 12,16 Z"/>
                        </RepeatButton>
                        <ScrollViewer x:Name="MonitorPointsSlider"
                                      Grid.Column="1"
                                      Margin="4,0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="HorizontalOnly"
                                      PreviewMouseWheel="MonitorPointsSlider_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding DashboardMonitorPoints}" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectMonitorPointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Width="104"
                                                Margin="0,0,8,0"
                                                Padding="6,4"
                                                HorizontalContentAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Chip"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="1.5"
                                                                        CornerRadius="8"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel>
                                                <Grid Width="52" Height="52" HorizontalAlignment="Center">
                                                    <Ellipse Width="52" Height="52" Opacity="0.22"
                                                             Fill="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"/>
                                                    <Ellipse Width="46" Height="46" Fill="{DynamicResource ChipFillBrush}"
                                                             Stroke="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"
                                                             StrokeThickness="2"/>
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                                                <Setter Property="FontSize" Value="20"/>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source, ElementName=PointLogo}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image x:Name="PointLogo" Width="28" Height="28" Margin="0"
                                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}">
                                                        <Image.Style>
                                                            <Style TargetType="Image" BasedOn="{StaticResource SiteLogoImage}">
                                                                <Setter Property="Width" Value="28"/>
                                                                <Setter Property="Height" Value="28"/>
                                                                <Setter Property="Margin" Value="0"/>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="0,4,0,3"
                                                           HorizontalAlignment="Center" TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Center"
                                                         Fill="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <RepeatButton Grid.Column="2"
                                      Style="{StaticResource MonitorPointNavButton}"
                                      Click="MonitorPointsScrollRight"
                                      VerticalAlignment="Center">
                            <Path Width="10" Height="16" Stretch="Uniform" Fill="White"
                                  Data="M 0,0 L 12,8 L 0,16 Z"/>
                        </RepeatButton>
                    </Grid>
                </DockPanel>

                <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource BorderColorBrush}" Margin="10,2"
                           Visibility="{Binding ShowNotifications, Converter={StaticResource BoolToVis}}"/>

                <DockPanel Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Top"
                           Visibility="{Binding ShowNotifications, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="Messages &amp; Issues Board" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource IssueBoardBrush}" CornerRadius="6" Padding="8,6" BorderBrush="{DynamicResource IssueBoardBorderBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Current Issues" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72">
                                <Grid>
                                    <TextBlock Text="No notifications right now." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                               Visibility="{Binding HasCurrentIssues, Converter={StaticResource InverseBoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding CurrentIssues}"
                                                  Visibility="{Binding HasCurrentIssues, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="12"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Severity}" Value="Unknown">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentGrayBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource IssueTextBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:DashboardView>
                <views:DashboardView.Style>
                    <Style TargetType="views:DashboardView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:DashboardView.Style>
            </views:DashboardView>
            <views:MonitorPointsView>
                <views:MonitorPointsView.Style>
                    <Style TargetType="views:MonitorPointsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Monitor Points">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MonitorPointsView.Style>
            </views:MonitorPointsView>
            <views:SettingsView>
                <views:SettingsView.Style>
                    <Style TargetType="views:SettingsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="views:SettingsView">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SettingsView.Style>
            </views:SettingsView>
            <views:SimpleTabView TitleText="About" BodyText="Agent Monitor. English UI with Arabic support planned.">
                <views:SimpleTabView.Style>
                    <Style TargetType="views:SimpleTabView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="About">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SimpleTabView.Style>
            </views:SimpleTabView>
        </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource SurfaceDarkAltBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,1,0,0"/>
    </Grid>
</Window>
