<Window x:Class="ClientAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClientAgent.UI.Views"
        Title="{Binding WindowTitle}"
        Width="1400"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundDarkBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="─" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="☐" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
                <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabButton}" Content="Dashboard" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Dashboard"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Dashboard, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Monitor Points" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Monitor Points"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Monitor Points, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Events" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Events"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Events, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Logs" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Logs"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Logs, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Config" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Config"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Config, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="Diagnostics" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="Diagnostics"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Diagnostics, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource TabButton}" Content="About" GroupName="MainTabs"
                             Command="{Binding SelectTabCommand}" CommandParameter="About"
                             IsChecked="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=About, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceDarkAltBrush}" CornerRadius="5" Margin="10"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding ServiceRunning, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                        <TextBlock Text="{Binding AgentStatus, StringFormat=Service: {0}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding MadkhalConnected, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                        <TextBlock Text="{Binding MadkhalStatus, StringFormat=Madkhal: {0}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding CentralConnected, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                        <TextBlock Text="{Binding CentralStatus, StringFormat=Central: {0}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Uptime, StringFormat=Uptime: {0}}" Margin="0,4"/>
                    <TextBlock Text="{Binding PendingText, StringFormat=Pending: {0}}" Margin="0,4"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SentTodayText, StringFormat=Sent Today: {0}}" Margin="0,4"/>
                    <TextBlock Text="{Binding AgentVersion}" Margin="0,4"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConfigVersionText}" Margin="0,4"/>
                    <TextBlock Text="{Binding LastSyncText}" Margin="0,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <views:DashboardView>
                <views:DashboardView.Style>
                    <Style TargetType="views:DashboardView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:DashboardView.Style>
            </views:DashboardView>
            <views:MonitorPointsView>
                <views:MonitorPointsView.Style>
                    <Style TargetType="views:MonitorPointsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Monitor Points">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:MonitorPointsView.Style>
            </views:MonitorPointsView>
            <views:EventsView>
                <views:EventsView.Style>
                    <Style TargetType="views:EventsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Events">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:EventsView.Style>
            </views:EventsView>
            <views:SimpleTabView TitleText="Logs" BodyText="Local agent logs are written to C:\ProgramData\ClientAgent\logs">
                <views:SimpleTabView.Style>
                    <Style TargetType="views:SimpleTabView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Logs">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SimpleTabView.Style>
            </views:SimpleTabView>
            <views:SimpleTabView TitleText="Config" BodyText="Configuration is pulled from Central API and cached locally. Use appsettings.json for routing and intervals.">
                <views:SimpleTabView.Style>
                    <Style TargetType="views:SimpleTabView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Config">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SimpleTabView.Style>
            </views:SimpleTabView>
            <views:SimpleTabView TitleText="Diagnostics" BodyText="Local API: http://127.0.0.1:5050  |  Outbox: C:\ProgramData\ClientAgent\outbox.db">
                <views:SimpleTabView.Style>
                    <Style TargetType="views:SimpleTabView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="Diagnostics">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SimpleTabView.Style>
            </views:SimpleTabView>
            <views:SimpleTabView TitleText="About" BodyText="UBG Monitor — Client Agent Dashboard. English UI with Arabic support planned.">
                <views:SimpleTabView.Style>
                    <Style TargetType="views:SimpleTabView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="About">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SimpleTabView.Style>
            </views:SimpleTabView>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FooterButton}" Content="{Binding IsPaused, Converter={StaticResource PauseLabelConverter}}" Command="{Binding PauseCommand}"/>
                    <Button Style="{StaticResource FooterButton}" Content="Export" Command="{Binding ExportCommand}"/>
                    <Button Style="{StaticResource FooterButton}" Content="Settings" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#AAAAAA" Text="{Binding LastUpdate, StringFormat=Last Update: {0}}"/>
                    <TextBlock Foreground="#AAAAAA" Margin="16,0,0,0" Text="{Binding RefreshIntervalText, StringFormat=Refresh: {0}}"/>
                    <TextBlock Foreground="#F44336" Margin="16,0,0,0" Text="{Binding ConnectionMessage}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
