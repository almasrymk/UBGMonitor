<Window x:Class="ClientAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClientAgent.UI.Views"
        Title="UBG Monitor"
        Height="720"
        Width="1100"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#252526" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="White" Text="{Binding AgentStatus, StringFormat=Agent: {0}}"/>
                <TextBlock Grid.Column="1" Foreground="White" Text="{Binding MadkhalStatus, StringFormat=Madkhal: {0}}"/>
                <TextBlock Grid.Column="2" Foreground="White" Text="{Binding CentralStatus, StringFormat=Central: {0}}"/>
                <TextBlock Grid.Column="3" Foreground="White" Text="{Binding Uptime, StringFormat=Uptime: {0}}"/>
                <TextBlock Grid.Column="4" Foreground="White" Text="{Binding PendingCount, StringFormat=Pending: {0}}"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#252526" CornerRadius="8" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="Pause" Command="{Binding PauseCommand}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="Export" Command="{Binding ExportCommand}" Padding="12,6"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="#CCCCCC">
                    <Run Text="Last Update:"/>
                    <Run Text="{Binding LastUpdate, Mode=OneWay}"/>
                    <Run Text="  "/>
                    <Run Text="{Binding ConnectionMessage, Mode=OneWay}" Foreground="#F44336"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <views:DashboardView/>
    </DockPanel>
</Window>
