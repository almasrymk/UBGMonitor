<UserControl x:Class="ClientAgent.UI.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Margin="10">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Recent Events" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid ItemsSource="{Binding RecentEvents}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat=HH:mm:ss}" Width="90"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding EventType}" Width="140"/>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Point" Binding="{Binding MonitorPointId}" Width="140"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
