<Window x:Class="ClientAgent.UI.Views.DatabaseLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database connection"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldInput}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource FieldPassword}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource FieldCheck}"/>
        <Style TargetType="Button" BasedOn="{StaticResource FooterButton}"/>
    </Window.Resources>
    <Border Padding="20" Background="{DynamicResource SurfaceDarkBrush}">
        <StackPanel>
            <TextBlock Text="Database connection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <TextBlock Text="Database type" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="EngineBox" DisplayMemberPath="Label" SelectionChanged="EngineBox_SelectionChanged" Margin="0,0,0,12"/>

            <TextBlock Text="Server" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="ServerBox" Margin="0,0,0,12"/>

            <TextBlock Text="Port" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="PortBox" Margin="0,0,0,12"/>

            <TextBlock Text="Database" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="DatabaseBox" Margin="0,0,0,12"/>

            <CheckBox x:Name="IntegratedBox" Content="Windows authentication" Margin="0,0,0,12"
                      Checked="IntegratedBox_Changed" Unchecked="IntegratedBox_Changed"/>

            <TextBlock x:Name="UserLabel" Text="Username" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="UserBox" Margin="0,0,0,12"/>

            <TextBlock x:Name="PasswordLabel" Text="Password" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordInput" Margin="0,0,0,8"/>
            <TextBlock Text="The password is encrypted and is written to the file only when you click Save."
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="90" Margin="0,0,8,0" Padding="8,6" Click="Ok_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Padding="8,6" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
