<UserControl x:Class="ClientAgent.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="GridCombo" TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MaxWidth" Value="10000"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style x:Key="OnOffToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Content" Value="Off"/>
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="On"/>
                    <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="#1B1B20"
                                BorderBrush="Transparent"
                                BorderThickness="1.5"
                                CornerRadius="6"
                                Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E32"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333338"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSideTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#333338"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsListItem}"/>
        </Style>
    </UserControl.Resources>

    <DockPanel DataContext="{Binding Settings}" Margin="8,4,16,12">
        <Border DockPanel.Dock="Left"
                Width="188"
                Background="{DynamicResource SurfaceDarkBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,0,1,0"
                Margin="0,0,12,0"
                Padding="8,8">
            <StackPanel>
                <RadioButton Style="{StaticResource SettingsSideTab}" Content="General" GroupName="SettingsSections"
                             Command="{Binding SelectSectionCommand}" CommandParameter="General"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter=General, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource SettingsSideTab}" Content="Monitor Points" GroupName="SettingsSections"
                             Command="{Binding SelectSectionCommand}" CommandParameter="Monitor Points"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Monitor Points, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource SettingsSideTab}" Content="Conditions" GroupName="SettingsSections"
                             Command="{Binding SelectSectionCommand}" CommandParameter="Conditions"
                             IsChecked="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Conditions, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SurfaceDarkAltBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource FooterButton}" Margin="0,0,8,0" Padding="18,6"/>
                <Button Content="Reset" Command="{Binding ResetCommand}" Style="{StaticResource FooterButton}" Margin="0" Padding="18,6"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="General">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="12,8,12,12" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="General" FontSize="20" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,6"/>
                    <TextBlock Text="Agent display and connection preferences." Foreground="#AAAAAA" Margin="0,0,0,18" TextWrapping="Wrap"/>

                    <TextBlock Text="Refresh Interval (seconds)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding RefreshInterval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"/>

                    <TextBlock Text="API Base URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"/>

                    <TextBlock Text="Theme" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" Style="{StaticResource FieldCombo}"/>

                    <TextBlock Text="Notifications" Style="{StaticResource FieldLabel}"/>
                    <ToggleButton IsChecked="{Binding NotificationsEnabled}" Style="{StaticResource OnOffToggle}"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Margin="12,8,4,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Monitor Points">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,12,12">
                    <TextBlock Text="Monitor Points" FontSize="20" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" Margin="0,0,0,10"
                               Text="Points are stored in the service appsettings.json. Edit a cell, then Save."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add" Command="{Binding AddMonitorPointCommand}"
                                Style="{StaticResource FooterButton}" Margin="0,0,8,0" Padding="18,6"/>
                        <Button Content="Delete" Command="{Binding RemoveMonitorPointCommand}"
                                Style="{StaticResource FooterButton}" Margin="0" Padding="18,6"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding MonitorPoints}"
                          SelectedItem="{Binding SelectedMonitorPoint}"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          Margin="0,0,12,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding MonitorPointId, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="2*" MinWidth="220"/>
                        <DataGridTemplateColumn Header="Type" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.MonitorPointTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Type"
                                              DisplayMemberPath="Label"
                                              Style="{StaticResource GridCombo}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Device" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsDevice, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DeviceGlyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DeviceKindLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DeviceKinds, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding DeviceKind, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Kind"
                                              Style="{StaticResource GridCombo}"
                                              Visibility="{Binding IsDevice, Converter={StaticResource BoolToVis}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Application" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding IsApplication, Converter={StaticResource BoolToVis}}">
                                        <Image Width="20" Height="20" Margin="0,0,8,0"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                               VerticalAlignment="Center"
                                               Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.InstalledApplications, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding ApplicationPath, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="ExecutablePath"
                                              Style="{StaticResource GridCombo}"
                                              Visibility="{Binding IsApplication, Converter={StaticResource BoolToVis}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="16" Height="16" Margin="0,0,6,0"
                                                           Source="{Binding IconBase64, Converter={StaticResource IconToImageConverter}}"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Database" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DatabaseSummary}"
                                            Click="ConfigureDatabase_Click"
                                            Style="{StaticResource FooterButton}"
                                            Margin="0"
                                            Padding="8,4"
                                            HorizontalAlignment="Left"
                                            Visibility="{Binding IsDatabase, Converter={StaticResource BoolToVis}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Address" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Style="{StaticResource SiteLogoImage}"
                                               Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                        <TextBlock Text="{Binding Address}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent" Foreground="White"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Shortcut" Binding="{Binding ShowInShortcut, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Interval" Binding="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Margin="12,8,4,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="Conditions">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,12,12">
                    <TextBlock Text="Conditions" FontSize="20" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA"
                               Text="Rules that raise a warning or a critical alert for a monitor point."/>
                </StackPanel>

                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <Button DockPanel.Dock="Top" Content="Add" Command="{Binding AddConditionCommand}"
                            Style="{StaticResource FooterButton}" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="18,6"/>
                    <ListBox ItemsSource="{Binding Conditions}"
                             SelectedItem="{Binding SelectedCondition}"
                             Style="{StaticResource SettingsList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock Text="No conditions yet. Use Add to create a rule."
                                   Foreground="#9A9AA5" Margin="8,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasSelectedCondition, Converter={StaticResource InverseBoolToVis}}"/>
                        <StackPanel MaxWidth="520" HorizontalAlignment="Left"
                                    Visibility="{Binding HasSelectedCondition, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SelectedCondition.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"/>

                            <TextBlock Text="Applies to" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding TargetOptions}"
                                      SelectedValue="{Binding SelectedCondition.TargetId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Label"
                                      Style="{StaticResource FieldCombo}"/>

                            <TextBlock Text="Rule" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding RuleOptions}"
                                      SelectedItem="{Binding SelectedCondition.Rule}"
                                      Style="{StaticResource FieldCombo}"/>

                            <StackPanel Visibility="{Binding SelectedCondition.IsResponseTime, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Threshold (seconds)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedCondition.Threshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldInput}"/>
                            </StackPanel>

                            <TextBlock Text="Severity" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding SeverityOptions}"
                                      SelectedItem="{Binding SelectedCondition.Severity}"
                                      Style="{StaticResource FieldCombo}"/>

                            <TextBlock Text="Enabled" Style="{StaticResource FieldLabel}"/>
                            <ToggleButton IsChecked="{Binding SelectedCondition.Enabled}" Style="{StaticResource OnOffToggle}"/>

                            <Button Content="Remove" Command="{Binding RemoveConditionCommand}"
                                    Style="{StaticResource FooterButton}" HorizontalAlignment="Left" Margin="0,4,0,12" Padding="18,6"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
