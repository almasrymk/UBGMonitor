<UserControl x:Class="ClientAgent.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ClientAgent.UI.Controls"
             xmlns:enums="clr-namespace:ClientAgent.UI.Enums"
             xmlns:views="clr-namespace:ClientAgent.UI.Views">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MacAddressBrush" Color="#64B5F6"/>
        <SolidColorBrush x:Key="ValueYellowBrush" Color="#FFD54F"/>
        <SolidColorBrush x:Key="ValuePurpleBrush" Color="#BA68C8"/>
        <Style x:Key="CopyHintToolTip" TargetType="ToolTip">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>
        <ToolTip x:Key="ClickToCopyHint" x:Shared="False" Style="{StaticResource CopyHintToolTip}">
            <TextBlock Text="Click to copy" Foreground="Black" FontWeight="Bold" FontSize="12"/>
        </ToolTip>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#9A9AA5" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                           MouseLeftButtonUp="CopyInfoRow_OnMouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F0F0F0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCopy}" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip" Value="{StaticResource ClickToCopyHint}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MacAddressBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOsHighlighted}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ValuePurpleBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMacHighlighted}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ValueYellowBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Ellipse Grid.Column="2" Width="10" Height="10" Margin="12,0,10,0" VerticalAlignment="Center"
                         Fill="{Binding Health, Converter={StaticResource SensorHealthToBrushConverter}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NetworkRowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#9A9AA5" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                           MouseLeftButtonUp="CopyInfoRow_OnMouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F0F0F0"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCopy}" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="ToolTip" Value="{StaticResource ClickToCopyHint}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MacAddressBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMacHighlighted}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource MacAddressBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- CPU / RAM / Network unified cards -->
            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Grid.Column="0" Margin="0,0,10,0" Padding="12" VerticalAlignment="Top">
                    <DockPanel LastChildFill="False">
                        <Grid DockPanel.Dock="Top" Height="200">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="CPU Usage" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                                <controls:SparklineControl DockPanel.Dock="Bottom" Height="28" Margin="0,8,0,0"
                                                           Values="{Binding Cpu.History}" Stroke="{StaticResource AccentGreenBrush}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:CircularProgressControl Value="{Binding Cpu.UsagePercent}"
                                                                      ProgressBrush="{Binding Cpu.UsagePercent, Converter={StaticResource PercentToBrushConverter}}"
                                                                      Width="90" Height="90"/>
                                    <UniformGrid Grid.Column="1" Columns="1" Margin="12,0,0,0">
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Cpu.UsagePercent, StringFormat=Usage: {0:0}%}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Cpu.CoresText, StringFormat=Cores: {0}}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Cpu.SpeedText, StringFormat=Speed: {0}}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Cpu.Temperature, StringFormat=Temp: {0}}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Cpu.ProcessCount, StringFormat=Procs: {0}}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Cpu.Model, StringFormat=Model: {0}}" TextWrapping="Wrap"/>
                                    </UniformGrid>
                                </Grid>
                            </DockPanel>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="#3A3A4D"/>
                        <views:ProcessListCard DockPanel.Dock="Top"
                                               VerticalAlignment="Top"
                                               Title="Top 5 by CPU"
                                               SortBy="{x:Static enums:ProcessSortBy.Cpu}"
                                               AccentColor="{StaticResource AccentGreenBrush}"
                                               DataContext="{Binding TopCpuCard}"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Grid.Column="1" Margin="0,0,10,0" Padding="12" VerticalAlignment="Top">
                    <DockPanel LastChildFill="False">
                        <Grid DockPanel.Dock="Top" Height="200">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="RAM Usage" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                                <controls:SparklineControl DockPanel.Dock="Bottom" Height="28" Margin="0,8,0,0"
                                                           Values="{Binding Ram.History}" Stroke="{StaticResource AccentBlueBrush}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:CircularProgressControl Value="{Binding Ram.UsagePercent}"
                                                                      ProgressBrush="{Binding Ram.UsagePercent, Converter={StaticResource PercentToBrushConverter}}"
                                                                      Width="90" Height="90"/>
                                    <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Ram.UsagePercent, StringFormat=Usage: {0:0}%}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Ram.TotalGb, StringFormat=Total: {0:0.0} GB}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Ram.UsedGb, StringFormat=Used: {0:0.0} GB}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Ram.FreeGb, StringFormat=Free: {0:0.0} GB}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Text="{Binding Ram.CachedGb, StringFormat=Cached: {0:0.0} GB}"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="#3A3A4D"/>
                        <views:ProcessListCard DockPanel.Dock="Top"
                                               VerticalAlignment="Top"
                                               Title="Top 5 by RAM"
                                               SortBy="{x:Static enums:ProcessSortBy.Ram}"
                                               AccentColor="{StaticResource AccentBlueBrush}"
                                               DataContext="{Binding TopRamCard}"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Grid.Column="2" Margin="0" Padding="12" VerticalAlignment="Top">
                    <DockPanel LastChildFill="False">
                        <Grid DockPanel.Dock="Top" Height="200">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Internet &amp; Network" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0"/>
                                <controls:SparklineControl DockPanel.Dock="Bottom" Height="28" Margin="0,8,0,0"
                                                           Values="{Binding Network.History}" Stroke="{StaticResource AccentBlueBrush}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:GaugeControl Grid.Column="0"
                                                           Width="168" Height="132"
                                                           Value="{Binding Network.DownloadMbps}"
                                                           Maximum="{Binding Network.GaugeMaximum}"
                                                           Unit="Mbps"
                                                           Subtitle="{Binding Network.ThroughputText}"
                                                           NeedleBrush="White"
                                                           VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="28,8,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Margin="0,0,0,4" Cursor="Hand"
                                                   ToolTip="{StaticResource ClickToCopyHint}"
                                                   Tag="PublicIp"
                                                   MouseLeftButtonUp="CopyNetworkValue_OnMouseLeftButtonUp">
                                            <Run Text="Public IP: " Foreground="#AAAAAA"/>
                                            <Run Text="{Binding Network.PublicIp, Mode=OneWay}" Foreground="{StaticResource MacAddressBrush}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Margin="0,0,0,4" Cursor="Hand"
                                                   ToolTip="{StaticResource ClickToCopyHint}"
                                                   Tag="LocalIp"
                                                   MouseLeftButtonUp="CopyNetworkValue_OnMouseLeftButtonUp">
                                            <Run Text="Local IP: " Foreground="#AAAAAA"/>
                                            <Run Text="{Binding Network.IpAddress, Mode=OneWay}" Foreground="{StaticResource MacAddressBrush}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"
                                                   Text="{Binding Network.Gateway, StringFormat=Gateway: {0}}"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"
                                                   Text="{Binding Network.Dns, StringFormat=DNS: {0}}" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="#AAAAAA" FontSize="12">
                                            <Run Text="Ping:"/>
                                            <Run Text="{Binding Network.Ping, Mode=OneWay}"/>
                                            <Run Text=" | Loss:"/>
                                            <Run Text="{Binding Network.PacketLoss, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="#3A3A4D"/>
                        <views:ProcessListCard DockPanel.Dock="Top"
                                               VerticalAlignment="Top"
                                               Title="Top 5 by Network"
                                               SortBy="{x:Static enums:ProcessSortBy.Network}"
                                               AccentColor="White"
                                               DataContext="{Binding TopNetworkCard}"/>
                    </DockPanel>
                </Border>
            </Grid>
            
            <!-- Row 5 -->
            <Grid Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Disk Status" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Disk.Partitions}"
                                      SelectedItem="{Binding Disk.SelectedPartition}"
                                      Cursor="Hand"
                                      HorizontalScrollBarVisibility="Auto"
                                      MouseDoubleClick="DiskPartitions_OnMouseDoubleClick"
                                      MouseLeave="DiskPartitions_OnMouseLeave">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Drive" Binding="{Binding Drive}" Width="55"/>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="80"/>
                                    <DataGridTextColumn Header="FS" Binding="{Binding FileSystem}" Width="55"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="70"/>
                                    <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="70"/>
                                    <DataGridTextColumn Header="Free" Binding="{Binding Free}" Width="70"/>
                                    <DataGridTemplateColumn Header="Usage" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding UsagePercent}" Height="8"
                                                  Foreground="{Binding UsagePercent, Converter={StaticResource PercentToBrushConverter}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Status" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                  Fill="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding Status}"/>
                                                    <TextBlock Text="{Binding UsagePercent, StringFormat= ({0:0}%)}" Foreground="#AAAAAA"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Monitor Points Summary" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                            <DockPanel LastChildFill="False">
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource FooterButton}"
                                        Content="View All Monitor Points →"
                                        Command="{Binding ViewAllMonitorPointsCommand}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentRedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CriticalCount, StringFormat=Critical: {0}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentYellowBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WarningCount, StringFormat=Warning: {0}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HealthyCount, StringFormat=Healthy: {0}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGrayBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UnknownCount, StringFormat=Unknown: {0}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}" Grid.Column="1" HorizontalAlignment="Stretch" Padding="10,15" Margin="0">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="Hardware &amp; OS" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,12"/>

                        <Expander Style="{StaticResource SectionExpanderStyle}"
                                  IsExpanded="{Binding HardwareOs.IsLevel1Expanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Basic Hardware" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentGreenBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HardwareOs.Level1Count, StringFormat=[{0}]}" FontSize="11" Foreground="#9A9AA5"/>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding HardwareOs.Level1Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                        </Expander>

                        <Border Height="1" Background="#3A3A4D" Margin="0,8"/>

                        <Expander Style="{StaticResource SectionExpanderStyle}"
                                  IsExpanded="{Binding HardwareOs.IsLevel2Expanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Extended Hardware" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentYellowBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HardwareOs.Level2Count, StringFormat=[{0}]}" FontSize="11" Foreground="#9A9AA5"/>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding HardwareOs.Level2Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                        </Expander>

                        <Border Height="1" Background="#3A3A4D" Margin="0,8"/>

                        <Expander Style="{StaticResource SectionExpanderStyle}"
                                  IsExpanded="{Binding HardwareOs.IsLevel5Expanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Network" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBlueBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HardwareOs.Level5Count, StringFormat=[{0}]}" FontSize="11" Foreground="#9A9AA5"/>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding HardwareOs.Level5Rows}" ItemTemplate="{StaticResource NetworkRowTemplate}"/>
                        </Expander>

                        <Border Height="1" Background="#3A3A4D" Margin="0,8"/>

                        <Expander Style="{StaticResource SectionExpanderStyle}"
                                  IsExpanded="{Binding HardwareOs.IsLevel4Expanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Detailed Info" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource ProcessBarNetworkBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HardwareOs.Level4Count, StringFormat=[{0}]}" FontSize="11" Foreground="#9A9AA5"/>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding HardwareOs.Level4Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                        </Expander>

                        <Border Height="1" Background="#3A3A4D" Margin="0,8"/>

                        <Expander Style="{StaticResource SectionExpanderStyle}"
                                  IsExpanded="{Binding HardwareOs.IsLevel3Expanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Live Sensors" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentRedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HardwareOs.Level3Count, StringFormat=[{0}]}" FontSize="11" Foreground="#9A9AA5"/>
                                </Grid>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding HardwareOs.Level3Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
            
           
        </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
