<UserControl x:Class="ClientAgent.UI.Views.Cards.CpuCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#252526" CornerRadius="8" Padding="16">
        <StackPanel>
            <TextBlock Text="CPU" FontSize="16" Foreground="#9CDCFE" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:0.0}%}" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UsagePercent}" Margin="0,8,0,12"
                         Foreground="{Binding UsagePercent, Converter={StaticResource PercentToBrushConverter}}"/>
            <TextBlock Text="{Binding Model}" Foreground="#CCCCCC" TextWrapping="Wrap"/>
            <TextBlock Foreground="#AAAAAA" Margin="0,4,0,0">
                <Run Text="Cores:"/>
                <Run Text="{Binding PhysicalCores, Mode=OneWay}"/>
                <Run Text="/"/>
                <Run Text="{Binding LogicalCores, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Foreground="#AAAAAA">
                <Run Text="Temp:"/>
                <Run Text="{Binding Temperature, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
