<UserControl x:Class="ClientAgent.UI.Views.Cards.DiskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#252526" CornerRadius="8" Padding="16">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="DISKS" FontSize="16" Foreground="#9CDCFE" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Partitions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:0.0}%}" DockPanel.Dock="Right" Foreground="White"/>
                                <TextBlock Text="{Binding DriveLetter}" Foreground="White" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UsagePercent}" Margin="0,4,0,2"
                                         Foreground="{Binding UsagePercent, Converter={StaticResource PercentToBrushConverter}}"/>
                            <TextBlock Foreground="#AAAAAA">
                                <Run Text="{Binding UsedGB, Mode=OneWay, StringFormat={}{0:0.00} GB}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding TotalGB, Mode=OneWay, StringFormat={}{0:0.00} GB}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
