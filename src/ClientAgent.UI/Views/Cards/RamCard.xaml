<UserControl x:Class="ClientAgent.UI.Views.Cards.RamCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#252526" CornerRadius="8" Padding="16">
        <StackPanel>
            <TextBlock Text="RAM" FontSize="16" Foreground="#9CDCFE" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding UsagePercent, StringFormat={}{0:0.0}%}" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding UsagePercent}" Margin="0,8,0,12"
                         Foreground="{Binding UsagePercent, Converter={StaticResource PercentToBrushConverter}}"/>
            <TextBlock Foreground="#CCCCCC" Text="{Binding TotalGb, StringFormat=Total: {0:0.00} GB}"/>
            <TextBlock Foreground="#AAAAAA" Text="{Binding UsedGb, StringFormat=Used: {0:0.00} GB}"/>
            <TextBlock Foreground="#AAAAAA" Text="{Binding FreeGb, StringFormat=Free: {0:0.00} GB}"/>
        </StackPanel>
    </Border>
</UserControl>
