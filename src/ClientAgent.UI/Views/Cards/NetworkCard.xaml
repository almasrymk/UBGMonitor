<UserControl x:Class="ClientAgent.UI.Views.Cards.NetworkCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#252526" CornerRadius="8" Padding="16">
        <StackPanel>
            <TextBlock Text="NETWORK" FontSize="16" Foreground="#9CDCFE" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding ActiveInterface}" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock Foreground="#4CAF50" Text="{Binding Status}" Margin="0,4,0,8"/>
            <TextBlock Foreground="#CCCCCC" Text="{Binding IpAddress, StringFormat=IP: {0}}"/>
            <TextBlock Foreground="#AAAAAA" Text="{Binding MacAddress, StringFormat=MAC: {0}}"/>
            <TextBlock Foreground="#AAAAAA" Text="{Binding Gateway, StringFormat=Gateway: {0}}"/>
            <TextBlock Foreground="#AAAAAA" Text="{Binding Speed, StringFormat=Speed: {0}}"/>
        </StackPanel>
    </Border>
</UserControl>
