<UserControl x:Class="ClientAgent.UI.Views.MonitorPointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Margin="10">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Monitor Points" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid ItemsSource="{Binding MonitorPoints}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding MonitorPointId}" Width="140"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="140"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="120"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80"/>
                    <DataGridTextColumn Header="Interval" Binding="{Binding IntervalSeconds}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
