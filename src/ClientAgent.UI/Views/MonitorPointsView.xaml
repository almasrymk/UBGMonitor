<UserControl x:Class="ClientAgent.UI.Views.MonitorPointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Margin="10">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Monitor Points" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="Double-click a monitor point to open its detailed report." Margin="16,0,0,0" FontSize="12"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding MonitorPoints}" IsReadOnly="True"
                      HorizontalScrollBarVisibility="Auto" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=PointIcon}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image x:Name="PointIcon" Width="22" Height="22"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}">
                                        <Image.Style>
                                            <Style TargetType="Image" BasedOn="{StaticResource SiteLogoImage}">
                                                <Setter Property="Width" Value="22"/>
                                                <Setter Property="Height" Value="22"/>
                                                <Setter Property="Margin" Value="0"/>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Id" Binding="{Binding MonitorPointId}" Width="72"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" MinWidth="170"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource MonitorPointTypeLabelConverter}}" Width="100"/>
                    <DataGridTextColumn Header="Device kind" Binding="{Binding DeviceKind, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=DeviceKind}" Width="95"/>
                    <DataGridTemplateColumn Header="Address / Target" Width="210" SortMemberPath="Target">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Target}">
                                    <Image Style="{StaticResource SiteLogoImage}"
                                           Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                    <TextBlock Text="{Binding Target}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="100"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="For" Binding="{Binding StatusSinceUtc, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Since}" Width="70"/>
                    <DataGridTextColumn Header="Response" Binding="{Binding ResponseMs, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Response}" Width="80"/>
                    <DataGridTextColumn Header="Last check" Binding="{Binding LastCheckedUtc, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Time}" Width="140"/>
                    <DataGridTemplateColumn Header="Result" Width="220" SortMemberPath="Message">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Enabled" Width="70" SortMemberPath="Enabled">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Path Style="{StaticResource YesNoMark}" Tag="{Binding Enabled}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Shortcut" Width="72" SortMemberPath="ShowInShortcut">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Path Style="{StaticResource YesNoMark}" Tag="{Binding ShowInShortcut}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Alert" Binding="{Binding Alert, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Alert}" Width="70"/>
                    <DataGridTextColumn Header="Interval" Binding="{Binding IntervalSeconds, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Seconds}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
