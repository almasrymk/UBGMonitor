<Window x:Class="ClientAgent.UI.Views.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/agent-monitor.png"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderColorBrush}"
            BorderThickness="1" CornerRadius="8" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="18,14,10,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Width="32" Height="28"
                        Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Close_Click" IsTabStop="False" VerticalAlignment="Top"/>
                <Grid Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse x:Name="IconCircle" Fill="{StaticResource AccentOrangeBrush}"/>
                    <TextBlock x:Name="IconText" Text="!" Foreground="White" FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="58,10,22,18" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" LineHeight="19"/>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceDarkAltBrush}" CornerRadius="0,0,8,8"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
