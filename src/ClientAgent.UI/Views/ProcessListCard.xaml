<UserControl x:Class="ClientAgent.UI.Views.ProcessListCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClientAgent.UI.Converters"
             xmlns:views="clr-namespace:ClientAgent.UI.Views"
             x:Name="Root"
             VerticalAlignment="Top">
    <UserControl.Resources>
        <converters:ProcessBarBrushConverter x:Key="ProcessBarBrushConverter"/>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Title, ElementName=Root}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{Binding AccentColor, ElementName=Root}"
                       Margin="0,8,0,8"/>
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem}"
                     DockPanel.Dock="Top"
                     VerticalAlignment="Top"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0"
                     Cursor="Hand"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Processes_OnMouseDoubleClick"
                     MouseLeave="Processes_OnMouseLeave">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,4"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#333338"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2F4A38"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="{Binding Icon}"
                                   Width="16"
                                   Height="16"
                                   Margin="0,0,2,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Pid}"
                                       FontSize="11"
                                       Foreground="#AAAAAA"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding DisplayValue}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,6,0"/>
                            <ProgressBar Grid.Column="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Percent}"
                                         Height="6"
                                         VerticalAlignment="Center">
                                <ProgressBar.Foreground>
                                    <MultiBinding Converter="{StaticResource ProcessBarBrushConverter}">
                                        <Binding Path="Percent"/>
                                        <Binding Path="SortBy" RelativeSource="{RelativeSource AncestorType={x:Type views:ProcessListCard}}"/>
                                    </MultiBinding>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#AAAAAA"
                   FontSize="12"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Margin="8"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="Loading..."
                   Foreground="#AAAAAA"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
