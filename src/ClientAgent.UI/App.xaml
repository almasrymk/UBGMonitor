<Application x:Class="ClientAgent.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClientAgent.UI.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:PercentToBrushConverter x:Key="PercentToBrushConverter"/>
        <SolidColorBrush x:Key="OkBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFC107"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Resources>
</Application>
