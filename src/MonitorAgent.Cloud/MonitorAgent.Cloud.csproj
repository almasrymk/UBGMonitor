<Project Sdk="Microsoft.NET.Sdk">

  <!-- Monitor Cloud connector (work package AG-3): enrollment, device token, gRPC stream, outbox, minute aggregates. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MonitorAgent.Cloud</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonitorAgent.Shared\MonitorAgent.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\monitor\agent\v1\agent.proto" ProtoRoot="..\..\proto" GrpcServices="Client" Link="Protos\agent.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MonitorAgent.Tests" />
  </ItemGroup>

</Project>
