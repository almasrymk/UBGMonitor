<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:MonitorAgent.Desktop.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MonitorAgent.Desktop.App"
             RequestedThemeVariant="Dark"
             Name="MonitorAgent">
    <Application.Resources>
        <!-- Theme brushes: UiTheme.Apply changes their colours for Dark / Light. -->
        <SolidColorBrush x:Key="BackgroundDarkBrush" Color="#161616"/>
        <SolidColorBrush x:Key="SurfaceDarkBrush" Color="#1C1C1D"/>
        <SolidColorBrush x:Key="SurfaceDarkAltBrush" Color="#242427"/>
        <SolidColorBrush x:Key="BorderColorBrush" Color="#343438"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="InputBrush" Color="#131318"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#262629"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#2A2A2F"/>
        <SolidColorBrush x:Key="SelectedAccentBrush" Color="#27402F"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#323232"/>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AltRowBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#313143"/>
        <SolidColorBrush x:Key="ChipFillBrush" Color="#131318"/>
        <SolidColorBrush x:Key="NavHoverBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A3A40"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#46464C"/>
        <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#525258"/>
        <SolidColorBrush x:Key="IssueBoardBrush" Color="#1C150D"/>
        <SolidColorBrush x:Key="IssueBoardBorderBrush" Color="#4E3312"/>
        <SolidColorBrush x:Key="IssueTextBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ToolTipBrush" Color="#2B2B2F"/>
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#48484E"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFC107"/>
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FF9800"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="AccentGrayBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="ProcessBarCpuHighBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="ProcessBarCpuMidBrush" Color="#FFC107"/>
        <SolidColorBrush x:Key="ProcessBarCpuLowBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ProcessBarRamBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="ProcessBarNetworkBrush" Color="#9C27B0"/>
        <SolidColorBrush x:Key="ProcessBarDiskBrush" Color="#AB47BC"/>

        <conv:PercentToBrushConverter x:Key="PercentToBrushConverter"/>
        <conv:EqualsConverter x:Key="EqualsConverter"/>
        <conv:NotEqualsConverter x:Key="NotEqualsConverter"/>
        <conv:MonitorPointTypeLabelConverter x:Key="MonitorPointTypeLabelConverter"/>
        <conv:MonitorPointFieldConverter x:Key="MonitorPointFieldConverter"/>
        <conv:IconToImageConverter x:Key="IconToImageConverter"/>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
        <conv:HealthToBrushConverter x:Key="HealthToBrushConverter"/>
        <conv:ByteSizeConverter x:Key="ByteSizeConverter"/>
        <conv:HealthPercentToBrushConverter x:Key="HealthPercentToBrushConverter"/>
        <conv:SensorHealthToBrushConverter x:Key="SensorHealthToBrushConverter"/>
        <conv:ProcessBarBrushConverter x:Key="ProcessBarBrushConverter"/>
        <conv:BoolToResourceBrushConverter x:Key="BoolToBrush"/>
        <conv:BoolToTextConverter x:Key="BoolToText"/>
        <conv:GlyphToIconConverter x:Key="GlyphToIcon"/>
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <mi:MaterialIconStyles/>

        <Style Selector="Window">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundDarkBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Every hint in the app follows the Dark / Light theme. -->
        <Style Selector="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ToolTipBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="400"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceDarkBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Image.logo">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsVisible" Value="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </Style>

        <!-- Title bar buttons -->
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="#E81123"/>
        </Style>

        <!-- Left navigation: icon over a label; the checked page is green with a bottom bar. -->
        <Style Selector="Button.nav">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center">
                            <mi:MaterialIcon Kind="{TemplateBinding Tag}" Width="22" Height="22" Margin="0,0,0,6"
                                             Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                              FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav.selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Button.nav.selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Side tabs (Settings sections, report types) -->
        <Style Selector="RadioButton.side">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.side:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="RadioButton.side:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="RadioButton.side:checked /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>

        <!-- Footer / toolbar buttons -->
        <Style Selector="Button.footer">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.footer:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <Style Selector="Button.footer:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.footer:disabled /template/ Border#Bd">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Button.footer.accent">
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.footer.accent:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.footer.accent:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.footer.danger">
            <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.footer.danger:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- A button that is only its content (icons, links, chips). -->
        <Style Selector="Button.plain, ToggleButton.plain">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="RepeatButton.chipnav">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Delay" Value="400"/>
            <Setter Property="Interval" Value="80"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RepeatButton.chipnav:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>
        <Style Selector="RepeatButton.chipnav:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        </Style>

        <!-- Collapsible section: arrow + header, content shown when expanded. -->
        <Style Selector="Expander.section">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <ToggleButton Classes="plain" Padding="6,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Name="Arrow" Text="▶" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          IsVisible="{TemplateBinding IsExpanded}" Margin="10,8,10,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Expander.section:expanded /template/ TextBlock#Arrow">
            <Setter Property="Text" Value="▼"/>
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="TextBox.field, ComboBox.field">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MaxWidth" Value="480"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectedAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="CheckBox.field">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Large check box for grid cells: one click toggles it. -->
        <Style Selector="CheckBox.grid">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent" Padding="8,6">
                        <Border Name="Box" Width="17" Height="17" CornerRadius="4"
                                Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.3">
                            <Path Name="Mark" Data="M 3.9,8.9 L 7.3,12.3 L 13.1,5.4" Stroke="White" StrokeThickness="2.1"
                                  StrokeLineCap="Round" StrokeJoin="Round" Margin="-1.3" IsVisible="False"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.grid:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="CheckBox.grid:checked /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="CheckBox.grid:checked /template/ Path#Mark">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Read-only yes / no mark: green check when the "yes" class is set, red cross otherwise. -->
        <Style Selector="Path.yesno">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="StrokeThickness" Value="2.6"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Data" Value="M 3,3 L 13,13 M 13,3 L 3,13"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentRedBrush}"/>
            <Setter Property="ToolTip.Tip" Value="No"/>
        </Style>
        <Style Selector="Path.yesno.yes">
            <Setter Property="Data" Value="M 2,8.5 L 6.5,13 L 14,3.5"/>
            <Setter Property="Stroke" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="ToolTip.Tip" Value="Yes"/>
        </Style>

        <Style Selector="ProgressBar:horizontal">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>

        <!-- Tables -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceDarkAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridCell > TextBlock">
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="DataGridRow.alt">
            <Setter Property="Background" Value="{DynamicResource AltRowBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource HoverBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource SelectedAccentBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="DataGridCell /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Application.Styles>
</Application>
