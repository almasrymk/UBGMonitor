<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MonitorAgent.Desktop.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MonitorAgent.Desktop.Views.MonitorPointsView">
    <UserControl.Styles>
        <Style Selector="Button.pointfilter"><Setter Property="Padding" Value="12,6"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="12"/></Style>
        <Style Selector="Button.pointfilter.selected"><Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/></Style>
    </UserControl.Styles>
    <Grid Margin="12" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="72,18,*,24,540" Margin="12,18,12,24">
            <mi:MaterialIcon Kind="Lan" Width="52" Height="52" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Monitor Points" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Monitor devices, services, applications and more." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
            <StackPanel Grid.Column="4" Spacing="8">
                <Grid ColumnDefinitions="*,12,140"><Border CornerRadius="6" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" Background="{DynamicResource InputBrush}" Height="38"><Grid ColumnDefinitions="34,*"><mi:MaterialIcon Kind="Magnify" Width="18" Height="18"/><TextBox Name="PointSearch" Grid.Column="1" Watermark="Search monitor points..." TextChanged="Filters_Changed" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="12"/></Grid></Border><ComboBox Name="PointTypeFilter" Grid.Column="2" Height="38" CornerRadius="6" HorizontalAlignment="Stretch" SelectionChanged="Filters_Changed"/></Grid>
                <StackPanel Orientation="Horizontal" Spacing="4"><Button Name="AllFilter" Classes="pointfilter selected" Tag="All" Click="StatusFilter_Click" Content="All"/><Button Name="HealthyFilter" Classes="pointfilter" Tag="Healthy" Click="StatusFilter_Click"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentGreenBrush}"/><TextBlock Name="HealthyCount" Text="Healthy"/></StackPanel></Button><Button Name="WarningFilter" Classes="pointfilter" Tag="Warning" Click="StatusFilter_Click"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentYellowBrush}"/><TextBlock Name="WarningCount" Text="Warning"/></StackPanel></Button><Button Name="ProblemFilter" Classes="pointfilter" Tag="Problem" Click="StatusFilter_Click"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentRedBrush}"/><TextBlock Name="ProblemCount" Text="Problem"/></StackPanel></Button></StackPanel>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" CornerRadius="10" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" Background="{DynamicResource SurfaceDarkBrush}"><Grid RowDefinitions="*,Auto">
            <Border Margin="10" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
            <controls:AppDataGrid Name="PointsGrid" HorizontalScrollBarVisibility="Auto" RowHeight="58" IsReadOnly="True" BorderThickness="0" DoubleTapped="Grid_DoubleTapped">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="46">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Panel Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:GlyphIcon Glyph="{Binding Glyph}" Size="16" HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     IsVisible="{Binding #PointIcon.Source, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Image x:Name="PointIcon" Width="22" Height="22" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Id" Binding="{Binding MonitorPointId}" Width="72"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" MinWidth="170"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource MonitorPointTypeLabelConverter}}" Width="100"/>
                    <DataGridTextColumn Header="Device kind" Binding="{Binding DeviceKind, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=DeviceKind}" Width="95"/>
                    <DataGridTemplateColumn Header="Address / Target" Width="210" SortMemberPath="Target">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Target}" VerticalAlignment="Center">
                                    <Image Classes="logo" Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                    <TextBlock Text="{Binding Target}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="100"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="100"/>
                    <DataGridTemplateColumn Header="Status" Width="80" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="For" Binding="{Binding StatusSinceUtc, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Since}" Width="70"/>
                    <DataGridTextColumn Header="Response" Binding="{Binding ResponseMs, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Response}" Width="80"/>
                    <DataGridTextColumn Header="Last check" Binding="{Binding LastCheckedUtc, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Time}" Width="140"/>
                    <DataGridTemplateColumn Header="Result" Width="220" SortMemberPath="Message">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" ToolTip.Tip="{Binding Message}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Enabled" Width="70" SortMemberPath="Enabled">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Path Classes="yesno" Classes.yes="{Binding Enabled}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Shortcut" Width="72" SortMemberPath="ShowInShortcut">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Path Classes="yesno" Classes.yes="{Binding ShowInShortcut}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Alert" Binding="{Binding Alert, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Alert}" Width="70"/>
                    <DataGridTextColumn Header="Interval" Binding="{Binding IntervalSeconds, Converter={StaticResource MonitorPointFieldConverter}, ConverterParameter=Seconds}" Width="70"/>
                </DataGrid.Columns>
            </controls:AppDataGrid>
        </Border><Border Grid.Row="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,1,0,0" Padding="20,14"><TextBlock Name="PointSummary" Text="Showing monitor points" FontSize="12"/></Border></Grid></Border></Grid></UserControl>
