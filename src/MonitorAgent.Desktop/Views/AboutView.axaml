<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MonitorAgent.Desktop.Views.AboutView">
    <UserControl.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="6,28,6,4"/>
        </Style>
        <Style Selector="TextBlock.intro">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Margin" Value="6,0,6,8"/>
        </Style>
        <Style Selector="Border.feature">
            <Setter Property="Background" Value="{DynamicResource SurfaceDarkAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style Selector="TextBlock.ftitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.ftext">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style Selector="TextBlock.bullet">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Margin" Value="4,3,0,0"/>
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.step">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style Selector="Border.step > TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card" Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" Margin="14,20,14,24">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="avares://MonitorAgent/Assets/monitoragent.png" Width="64" Height="64" Margin="0,0,16,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MonitorAgent" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Computer, network and systems monitoring" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Classes="title" Text="License"/>
                <Border Classes="feature" DataContext="{Binding License}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Classes="dot" Fill="{Binding Health, Converter={StaticResource HealthToBrushConverter}}"/>
                            <TextBlock Classes="ftitle" Text="{Binding StateText}"/>
                        </StackPanel>
                        <TextBlock Classes="ftext" Text="{Binding Message}"/>
                        <TextBlock Classes="bullet" Margin="0,2,0,0" Text="{Binding Details}"
                                   IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <DockPanel Margin="0,12,0,0" IsVisible="{Binding CanEnterKey}">
                            <Button DockPanel.Dock="Right" Classes="footer accent" Content="Activate" Command="{Binding ActivateCommand}"
                                    Margin="8,0,0,0" Padding="18,6"/>
                            <TextBox Classes="field" Text="{Binding ProductKey}" Watermark="Product key: XXXX-XXXX-XXXX-XXXX-XXXX"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Classes="footer" Content="Check now" Command="{Binding CheckNowCommand}" Margin="0,0,8,0" Padding="18,6"/>
                            <Button Classes="footer danger" Content="Release this computer" Command="{Binding ReleaseCommand}"
                                    IsVisible="{Binding CanRelease}" Padding="18,6"/>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding ResultMessage}" IsVisible="{Binding HasResult}"
                                   Foreground="{Binding ResultHealth, Converter={StaticResource HealthToBrushConverter}}"/>
                    </StackPanel>
                </Border>

                <TextBlock Classes="title" Text="What is MonitorAgent?"/>
                <Border Classes="feature">
                    <StackPanel>
                        <TextBlock Classes="ftext" Margin="0" FontSize="14" LineHeight="22" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="MonitorAgent watches this computer and everything the work depends on: the device itself, the internet connection, and the websites, devices, applications and databases you choose."/>
                        <TextBlock Classes="ftext" LineHeight="20"
                                   Text="Instead of waiting for someone to report that something stopped working, the program checks everything on a schedule, shows the result with clear colors, and warns you the moment a value crosses a limit you set. The goal is to find problems early, understand where they are, and fix them before they stop the work."/>
                    </StackPanel>
                </Border>

                <TextBlock Classes="title" Text="How it works"/>
                <TextBlock Classes="intro" Text="The program is made of two parts that work together."/>
                <UniformGrid Columns="2">
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentBlueBrush}"/>
                                <TextBlock Classes="ftitle" Text="The monitoring service"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="A background service that starts with the computer and runs all the time."/>
                            <TextBlock Classes="bullet" Text="•  Collects the device, network and monitor point readings."/>
                            <TextBlock Classes="bullet" Text="•  Compares every reading with your limits and decides its status."/>
                            <TextBlock Classes="bullet" Text="•  Keeps working even when this window is closed or nobody is signed in."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentGreenBrush}"/>
                                <TextBlock Classes="ftitle" Text="This app"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="The window you are using now. It connects to the service and presents what it found."/>
                            <TextBlock Classes="bullet" Text="•  Shows live status on the dashboard and in each screen."/>
                            <TextBlock Classes="bullet" Text="•  Lists warnings and problems in the Messages &amp; Issues board."/>
                            <TextBlock Classes="bullet" Text="•  Lets you manage monitor points, limits and check intervals in Settings."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Classes="title" Text="What it monitors"/>
                <TextBlock Classes="intro" Text="Each area is checked on its own interval, which you can change in Settings › General."/>
                <UniformGrid Columns="2">
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentBlueBrush}"/>
                                <TextBlock Classes="ftitle" Text="Device health"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="The state of this computer compared with the specifications you set in Settings › Device Specifications."/>
                            <TextBlock Classes="bullet" Text="•  CPU: number of cores and usage, with warning and problem percentages."/>
                            <TextBlock Classes="bullet" Text="•  Memory: installed RAM and usage."/>
                            <TextBlock Classes="bullet" Text="•  Disk: size and remaining free space on every partition."/>
                            <TextBlock Classes="bullet" Text="•  Hardware and operating system details."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentYellowBrush}"/>
                                <TextBlock Classes="ftitle" Text="Internet &amp; network"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Makes sure the computer is connected and the connection is fast enough."/>
                            <TextBlock Classes="bullet" Text="•  Checks whether the internet is reachable."/>
                            <TextBlock Classes="bullet" Text="•  Runs download and upload speed tests on a schedule."/>
                            <TextBlock Classes="bullet" Text="•  Alerts you when the speed drops below the minimum you set."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentOrangeBrush}"/>
                                <TextBlock Classes="ftitle" Text="Monitor points"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Anything else the work depends on. Add as many as you need in Settings › Monitor Points."/>
                            <TextBlock Classes="bullet" Text="•  Websites: checks that the site opens and responds."/>
                            <TextBlock Classes="bullet" Text="•  Devices: printers, servers, cameras or any device on the network."/>
                            <TextBlock Classes="bullet" Text="•  Applications: checks that a program is running on this computer."/>
                            <TextBlock Classes="bullet" Text="•  Databases: SQL Server, MySQL and PostgreSQL connections."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentRedBrush}"/>
                                <TextBlock Classes="ftitle" Text="Messages &amp; issues"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Every warning and problem is collected in one board, so nothing gets missed."/>
                            <TextBlock Classes="bullet" Text="•  Shows what went wrong, where, and when."/>
                            <TextBlock Classes="bullet" Text="•  The board can be turned off in Settings."/>
                            <TextBlock Classes="bullet" Text="•  Clears automatically when the problem is solved."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Classes="feature">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Classes="dot" Fill="{DynamicResource AccentGreenBrush}"/>
                            <TextBlock Classes="ftitle" Text="Reports"/>
                        </StackPanel>
                        <TextBlock Classes="ftext" Text="Every reading is kept, so you can look back at any period."/>
                        <TextBlock Classes="bullet" Text="•  Summary, problems and warnings, availability, device health, specifications compliance, internet quality, settings changes and device inventory."/>
                        <TextBlock Classes="bullet" Text="•  Double-click any row to open its details."/>
                        <TextBlock Classes="bullet" Text="•  Export to HTML, or to CSV for Excel."/>
                    </StackPanel>
                </Border>

                <TextBlock Classes="title" Text="Works on Windows, Linux and macOS"/>
                <TextBlock Classes="intro" Text="The same service and app run on all three systems, with the same screens, settings and reports."/>
                <UniformGrid Columns="3">
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentBlueBrush}"/>
                                <TextBlock Classes="ftitle" Text="Windows"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="The service runs as a Windows service and starts with Windows."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentOrangeBrush}"/>
                                <TextBlock Classes="ftitle" Text="Linux"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Ubuntu, Debian, Red Hat, Fedora and other systemd systems. Installed from the .deb package or the install script."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentGrayBrush}"/>
                                <TextBlock Classes="ftitle" Text="macOS"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="macOS 12 or later, on Intel and Apple silicon. Installed from the .pkg package or the install script."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Classes="title" Text="Understanding the colors"/>
                <TextBlock Classes="intro" Text="The same colors are used everywhere in the program, so you can read the status at a glance."/>
                <UniformGrid Columns="4">
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentGreenBrush}"/>
                                <TextBlock Classes="ftitle" Text="OK"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Working normally. Nothing to do."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentYellowBrush}"/>
                                <TextBlock Classes="ftitle" Text="Warning"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Still working, but getting close to a limit. Keep an eye on it."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentRedBrush}"/>
                                <TextBlock Classes="ftitle" Text="Problem"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Stopped or over the limit. Needs attention now."/>
                        </StackPanel>
                    </Border>
                    <Border Classes="feature">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Classes="dot" Fill="{DynamicResource AccentGrayBrush}"/>
                                <TextBlock Classes="ftitle" Text="Unknown"/>
                            </StackPanel>
                            <TextBlock Classes="ftext" Text="Not checked yet, or the result could not be read."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Classes="title" Text="Getting started"/>
                <TextBlock Classes="intro" Text="Three steps are enough to set up the program for a new computer."/>
                <Border Classes="feature">
                    <StackPanel>
                        <DockPanel Margin="0,4,0,10">
                            <Border Classes="step"><TextBlock Text="1"/></Border>
                            <StackPanel>
                                <TextBlock Classes="ftitle" Text="Settings › General"/>
                                <TextBlock Classes="ftext" Margin="0,4,0,0"
                                           Text="Give the device a name, choose how often each area is checked, and pick the theme and notifications."/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border Classes="step"><TextBlock Text="2"/></Border>
                            <StackPanel>
                                <TextBlock Classes="ftitle" Text="Settings › Monitor Points"/>
                                <TextBlock Classes="ftext" Margin="0,4,0,0"
                                           Text="Add the websites, devices, applications and databases you want to watch, and choose the alert level for each one."/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <Border Classes="step"><TextBlock Text="3"/></Border>
                            <StackPanel>
                                <TextBlock Classes="ftitle" Text="Settings › Device Specifications"/>
                                <TextBlock Classes="ftext" Margin="0,4,0,0"
                                           Text="Set the minimum specifications and the warning and problem limits for CPU, memory, disk and internet speed."/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Classes="title" Text="Tips"/>
                <Border Classes="feature">
                    <StackPanel>
                        <TextBlock Classes="bullet" Margin="0" Text="•  Drag the dashboard panels to any empty place, drop one on another to swap them, and resize them from their edges."/>
                        <TextBlock Classes="bullet" Text="•  Hold Ctrl and click several panels to select them and move them together."/>
                        <TextBlock Classes="bullet" Text="•  Use Reset layout in the title bar to go back to your saved layout or the original one."/>
                        <TextBlock Classes="bullet" Text="•  Use the pin buttons to auto-hide the menu and the Service Status panel and get more space."/>
                        <TextBlock Classes="bullet" Text="•  The Back button, the mouse back button or Alt+Left return to the previous screens."/>
                        <TextBlock Classes="bullet" Text="•  Each Settings tab is saved on its own. You will be asked before leaving a tab with unsaved changes."/>
                        <TextBlock Classes="bullet" Text="•  To show another computer, enter its address and access key in Settings › General › This app connects to."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
