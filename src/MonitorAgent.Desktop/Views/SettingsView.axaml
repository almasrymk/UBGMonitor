<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MonitorAgent.Desktop.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MonitorAgent.Desktop.Views.SettingsView">
    <UserControl.Resources>
        <!-- Which service this app shows; used in the General section and in the "not answering" banner. -->
        <DataTemplate x:Key="ConnectFields">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,24,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Service URL" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid ColumnDefinitions="*,40" ColumnSpacing="8">
                            <TextBox Classes="field wide" Height="35" MinHeight="35" Margin="0" Padding="12,5" CornerRadius="5" Text="{Binding ApiBaseUrl}" ToolTip.Tip="This computer: 127.0.0.1. Remote: https://pc-name:5050"/>
                            <Button Grid.Column="1" Tag="url" Click="CopyConnectionValue_Click" Height="35" MinWidth="0" Padding="8" CornerRadius="5" ToolTip.Tip="Click to copy"><mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/></Button>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="Access key (of that service, if it has one)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid ColumnDefinitions="*,40" ColumnSpacing="8">
                            <TextBox Classes="field wide" Height="35" MinHeight="35" Margin="0" Padding="12,5" CornerRadius="5" Text="{Binding ClientAccessKey}" Watermark="Enter access key..."/>
                            <Button Grid.Column="1" Tag="client-key" Click="CopyConnectionValue_Click" Height="35" MinWidth="0" Padding="8" CornerRadius="5" ToolTip.Tip="Click to copy"><mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/></Button>
                        </Grid>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Background="{DynamicResource AccentGreenBrush}" Foreground="White" Command="{Binding ConnectCommand}" Height="35" Width="120" Padding="12,5" CornerRadius="5">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Play" Width="18" Height="18"/><TextBlock Text="Connect" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ResetPairingCommand}" Height="35" Width="145" Padding="12,5" CornerRadius="5">
                        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Refresh" Width="18" Height="18"/><TextBlock Text="Reset pairing" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <TextBlock Classes="connmsg" Classes.ok="{Binding IsConnectionOk}" Text="{Binding ConnectionMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,0,0" MaxWidth="700"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AlertItem">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Brush}"/>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="NumericUpDown.monitorcompact">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <ButtonSpinner Name="PART_Spinner" AllowSpin="{TemplateBinding AllowSpin}" ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <TextBox Name="PART_TextBox" Text="{TemplateBinding Text}" IsReadOnly="{TemplateBinding IsReadOnly}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Padding="12,0" Margin="0" FontSize="13"/>
                        </ButtonSpinner>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown.monitorcompact /template/ TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.monitorcompact /template/ TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.monitorcompact /template/ TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.monitorcompact /template/ RepeatButton /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown.monitorcompact /template/ ButtonSpinner">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,28">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Border Grid.Column="1" Width="20" Height="28" Margin="0,0,5,0" CornerRadius="4" Background="#2A2D33" VerticalAlignment="Center">
                            <Grid RowDefinitions="*,*">
                                <RepeatButton Name="PART_IncreaseButton" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0" Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Increase"><mi:MaterialIcon Kind="ChevronUp" Width="12" Height="12"/></RepeatButton>
                                <RepeatButton Name="PART_DecreaseButton" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0" Padding="0" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Decrease"><mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12"/></RepeatButton>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown.monitorcompact /template/ TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style Selector="Border.settingscard"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceDarkBrush}"/></Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
            </Setter>
        </Style>
        <Style Selector="TextBlock.flabel">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.connmsg">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.connmsg.ok">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="TextBox.wide, ComboBox.wide">
            <Setter Property="MaxWidth" Value="10000"/>
        </Style>
        <Style Selector="TextBox.spec, ComboBox.spec">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MaxWidth" Value="10000"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.cell">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.spec">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Settings side tabs. -->
        <Style Selector="Button.stab">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.stab:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.stab.selected">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
        <Style Selector="Button.stab.selected /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>

        <!-- On / Off switch. -->
        <Style Selector="ToggleButton.onoff">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Content" Value="Off"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Track" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <Panel>
                            <TextBlock Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,7,0" IsHitTestVisible="False"/>
                            <Border Name="Knob" Width="17" Height="17" CornerRadius="8.5" Background="{TemplateBinding BorderBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                    BoxShadow="0 1 4 0 #47000000" IsHitTestVisible="False"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.onoff:checked">
            <Setter Property="Content" Value="On"/>
            <Setter Property="Background" Value="{DynamicResource AccentGreenBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.onoff:checked /template/ TextBlock#Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
        </Style>
        <Style Selector="ToggleButton.onoff:checked /template/ Border#Knob">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>
        <Style Selector="ToggleButton.onoff:disabled /template/ Border#Track">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="ToggleButton.onoff.theme">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Content" Value="Dark"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#F3F3F3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ToggleButton.onoff.theme:checked">
            <Setter Property="Content" Value="Light"/>
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#1E1E1E"/>
        </Style>

        <!-- Delete row button. -->
        <Style Selector="Button.bin">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" Background="Transparent" CornerRadius="5">
                        <Path Name="Bin" Width="13" Height="15" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                              Data="M 5,0 L 9,0 L 9,1.5 L 14,1.5 L 14,3.5 L 0,3.5 L 0,1.5 L 5,1.5 Z M 1.2,4.5 L 12.8,4.5 L 12,16 L 2,16 Z M 4,6.5 L 4,14 L 5.5,14 L 5.5,6.5 Z M 6.25,6.5 L 6.25,14 L 7.75,14 L 7.75,6.5 Z M 8.5,6.5 L 8.5,14 L 10,14 L 10,6.5 Z"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.bin:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.bin:pointerover /template/ Path#Bin">
            <Setter Property="Fill" Value="{DynamicResource AccentRedBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel DataContext="{Binding Settings}" Margin="8,4,16,12">
        <Border DockPanel.Dock="Left" Width="188"
                Background="{DynamicResource SurfaceDarkBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,1,0"
                Margin="0,0,12,0" Padding="8">
            <StackPanel>
                <Button Classes="stab"
                        Classes.selected="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter=General}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="General"><StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="CogOutline" Width="20" Height="20" VerticalAlignment="Center"/><TextBlock Text="General" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Classes="stab"
                        Classes.selected="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter='Monitor Points'}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="Monitor Points"><StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="ChartBar" Width="20" Height="20" VerticalAlignment="Center"/><TextBlock Text="Monitor Points" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Classes="stab"
                        Classes.selected="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Conditions}"
                        Command="{Binding SelectSectionCommand}" CommandParameter="Conditions"><StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="FileDocumentOutline" Width="20" Height="20" VerticalAlignment="Center"/><TextBlock Text="Device Specifications" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsLoaded}"
                Background="{DynamicResource SurfaceDarkAltBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Background="{DynamicResource AccentGreenBrush}" Content="Save Changes" Click="SaveSettings_Click" Classes="footer" Margin="0,0,8,0" Padding="18,6"
                        ToolTip.Tip="Save the changes in this tab" ToolTip.ShowOnDisabled="True"/>
                <Button Content="Reset" Click="Reset_Click" Classes="footer" Margin="0" Padding="18,6"
                        IsEnabled="{Binding HasChanges}" ToolTip.Tip="Undo the unsaved changes in this tab"
                        ToolTip.ShowOnDisabled="True"/>
                <Panel Width="22" Height="22" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Saved"
                       IsVisible="{Binding IsSavedBadgeVisible}">
                    <Ellipse Fill="{DynamicResource AccentGreenBrush}"/>
                    <Path Data="M 5,11.5 L 9.5,16 L 17,7" Stroke="White" StrokeThickness="2.4"
                          StrokeLineCap="Round" StrokeJoin="Round"/>
                </Panel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding AccessExplanation}" IsVisible="{Binding !CanAdminister}" Margin="0,8"/>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConnectFields}" IsVisible="{Binding !CanAdminister}"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="12,8,12,0" Padding="12,10" CornerRadius="4"
                Background="{DynamicResource SurfaceDarkAltBrush}"
                BorderBrush="{DynamicResource AccentRedBrush}" BorderThickness="1"
                IsVisible="{Binding !IsLoaded}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:GlyphIcon Glyph="&#xE7BA;" Size="16" Foreground="{DynamicResource AccentRedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="The Agent service is not answering. Settings are loaded from and saved by the service, so they will appear when it answers."/>
                </StackPanel>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,8"
                           Text="If the service is on another computer, or on another port, type its address and connect:"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConnectFields}"/>
            </StackPanel>
        </Border>

        <Panel IsVisible="{Binding IsLoaded}" IsEnabled="{Binding CanAdminister}" ToolTip.Tip="{Binding AccessExplanation}">
            <!-- General -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter=General}">
                <StackPanel Margin="12,8,12,12">
                    <Grid ColumnDefinitions="78,16,*" Margin="0,4,0,26">
                        <Border Width="78" Height="76" CornerRadius="12" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"><mi:MaterialIcon Kind="CogOutline" Width="48" Height="48" Foreground="{DynamicResource AccentGreenBrush}"/></Border>
                        <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="General Monitoring Settings" FontSize="22" FontWeight="Bold"/><TextBlock Text="Configure monitoring intervals and data retention settings for this device." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="These settings control how often different components are checked and how long data is kept." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                    <Border Classes="settingscard"><StackPanel Spacing="8">
                        <Grid ColumnDefinitions="38,16,*"><mi:MaterialIcon Kind="ClockOutline" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Top"/><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Monitoring Intervals" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Set how often MonitorAgent checks different components on this device. All values are in seconds." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                        <Grid ColumnDefinitions="*,32,*"><StackPanel><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Device name" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Name of this device (for identification)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><TextBox Text="{Binding MachineName}" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="10,5"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Service (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check Windows service status" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding RefreshInterval}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Internet &amp; Network (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check network connectivity and status" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding InternetIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Internet speed test (seconds, 0 = off)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Run internet speed test (0 to disable)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding SpeedTestIntervalSeconds}" Minimum="0" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Applications › Programs (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check running programs" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding ProgramsIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border></StackPanel><StackPanel Grid.Column="2"><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="RAM (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check memory usage" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding RamIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Disk (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check disk usage and health" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding DiskIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="CPU (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check processor usage" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding CpuIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Hardware &amp; OS (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check hardware and OS information" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding HardwareOsIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Applications › Services (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check application services" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding ServicesIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0" Padding="0,12"><Grid ColumnDefinitions="*,16,*"><StackPanel Spacing="4"><TextBlock Text="Applications › Users (seconds)" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Check user sessions" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ContentControl Grid.Column="2" VerticalAlignment="Center"><NumericUpDown Classes="monitorcompact" Value="{Binding UsersIntervalSeconds}" Minimum="1" Maximum="2147483647" Increment="1" FormatString="0" Height="38" MinHeight="38" FontSize="13" CornerRadius="5" Padding="0"/></ContentControl></Grid></Border></StackPanel></Grid></StackPanel></Border>                    <Grid ColumnDefinitions="*,14,*">
                        <Border Classes="settingscard"><StackPanel Spacing="12">
                            <Grid ColumnDefinitions="38,16,*"><mi:MaterialIcon Kind="DatabaseOutline" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}"/><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Data Retention" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Control how long monitoring data and logs are stored on this device." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                            <Grid ColumnDefinitions="*,16,*"><StackPanel><TextBlock Text="Keep data for" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Choose how long to keep monitoring data, logs and report history." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><ComboBox Grid.Column="2" Classes="field wide" Height="38" Margin="0" CornerRadius="5" ItemsSource="{Binding RetentionOptions}" SelectedValueBinding="{Binding Days}" DisplayMemberBinding="{Binding Label}" SelectedValue="{Binding DataRetentionDays}"/></Grid>
                            <Grid ColumnDefinitions="24,*"><mi:MaterialIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="Older logs, saved data and report history are deleted permanently." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></Grid>
                        </StackPanel></Border>
                        <Border Grid.Column="2" Classes="settingscard"><StackPanel Spacing="12">
                            <Grid ColumnDefinitions="38,16,*"><mi:MaterialIcon Kind="Tune" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}"/><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Customize the appearance and behavior of the application." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                            <Grid ColumnDefinitions="*,24,*"><StackPanel Spacing="4"><TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Choose application theme." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="12"><RadioButton Content="Dark" GroupName="SettingsTheme" IsChecked="{Binding !IsLightTheme}"/><RadioButton Content="Light" GroupName="SettingsTheme" IsChecked="{Binding IsLightTheme}"/></StackPanel></StackPanel><Border Grid.Column="1" Width="1" Background="{DynamicResource BorderColorBrush}"/><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Notifications" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Show notifications for important events." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><ToggleButton Classes="onoff" IsChecked="{Binding NotificationsEnabled}"/></StackPanel></StackPanel></Grid>
                        </StackPanel></Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,6"><mi:MaterialIcon Kind="ShieldCheck" Width="28" Height="28" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><TextBlock Text="Secure Remote Access" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Configure secure remote access for this device. Choose the listening address and port; keys are prepared automatically. Changes to access and firewall options are applied when you click Save."/>
                    <Border Classes="settingscard">
                        <Grid ColumnDefinitions="32,16,*">
                            <mi:MaterialIcon Kind="Web" Width="26" Height="26" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Top" Margin="0,0,0,0"/>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="Connection Endpoint" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Choose the network interface and port for the remote access service." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,20,*" Margin="0,2,0,0">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Listen address" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                        <ComboBox Classes="field wide" Height="35" MinHeight="35" Margin="0" Padding="12,5" CornerRadius="5"
                                                  ItemsSource="{Binding ListenAddressOptions}" SelectedValueBinding="{Binding Address}"
                                                  DisplayMemberBinding="{Binding Label}" SelectedValue="{Binding ServiceListenAddress}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Service port" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                        <TextBox Classes="field wide" Height="35" MinHeight="35" Margin="0" Padding="12,5" CornerRadius="5" Text="{Binding ServicePort}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel IsVisible="{Binding NetworkIndicatorsVisible}" Orientation="Horizontal" Spacing="28" Margin="0,6,0,0">
                                    <Grid ColumnDefinitions="32,14,*">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGreenBrush}" VerticalAlignment="Top">
                                            <mi:MaterialIcon Kind="Check" Width="20" Height="20" Foreground="White"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="HTTPS Enabled" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                            <TextBlock Text="Remote access uses HTTPS when saved." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="32,14,*">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentGreenBrush}" VerticalAlignment="Top">
                                            <mi:MaterialIcon Kind="Check" Width="20" Height="20" Foreground="White"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="Firewall Port Open" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                            <TextBlock Text="The service port opens when you save." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settingscard" IsVisible="{Binding NetworkIndicatorsVisible}"><Grid ColumnDefinitions="32,16,*"><mi:MaterialIcon Kind="AccountGroup" Width="28" Height="28" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/><StackPanel Grid.Column="2" Spacing="8" IsEnabled="{Binding CanManageRemoteAccess}">
                        <TextBlock Text="Access Permissions" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Manage remote viewer and administrator permissions." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10"><ToggleButton Classes="onoff" IsChecked="{Binding RemoteKeyPanelOpen}"/><StackPanel><TextBlock Text="Allow remote administration with a separate admin key"/><TextBlock Text="When enabled, a separate administrator key is required for administration." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
                        <StackPanel IsVisible="{Binding NetworkIndicatorsVisible}" Spacing="8" Margin="0,2,0,0">
                                                        <Grid ColumnDefinitions="130,*,44,124,28" HorizontalAlignment="Stretch" MaxWidth="950" ColumnSpacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><mi:MaterialIcon Kind="KeyVariant" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Viewer key" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource BackgroundDarkBrush}" Height="34" Padding="10,5"><TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}" Cursor="Hand" ToolTip.Tip="Click to copy" Tag="viewer" PointerReleased="RemoteKey_PointerReleased" Text="{Binding ViewerKeyDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border>
                                <Button Grid.Column="2" Tag="viewer" Click="CopyRemoteKey_Click" ToolTip.Tip="Click to copy" Classes="footer" Height="34" MinHeight="0" Margin="0" Padding="6" MinWidth="0"><mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/></Button>
                                <Button Grid.Column="3" Command="{Binding ManageRemoteAccessCommand}" CommandParameter="create-viewer-key" Classes="footer" Height="34" MinHeight="0" Margin="0" Padding="8,4" FontSize="12"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/><TextBlock Text="Regenerate"/></StackPanel></Button>
                            </Grid>
                                                        <Grid ColumnDefinitions="130,*,44,124,28" HorizontalAlignment="Stretch" MaxWidth="950" ColumnSpacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><mi:MaterialIcon Kind="KeyVariant" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Admin key" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource BackgroundDarkBrush}" Height="34" Padding="10,5"><TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}" Cursor="Hand" ToolTip.Tip="Click to copy" Tag="admin" PointerReleased="RemoteKey_PointerReleased" Text="{Binding AdminKeyDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Border>
                                <Button Grid.Column="2" Tag="admin" Click="CopyRemoteKey_Click" ToolTip.Tip="Click to copy" Classes="footer" Height="34" MinHeight="0" Margin="0" Padding="6" MinWidth="0"><mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/></Button>
                                <Button Grid.Column="3" Command="{Binding ManageRemoteAccessCommand}" CommandParameter="create-admin-key" Classes="footer" Height="34" MinHeight="0" Margin="0" Padding="8,4" FontSize="12"><StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/><TextBlock Text="Regenerate"/></StackPanel></Button>
                                <CheckBox Grid.Column="4" IsChecked="{Binding RemoteAdministration}" IsEnabled="{Binding RemoteKeyPanelOpen}" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip.Tip="Allow administrator access"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel></Grid></Border>
                    <Border Classes="settingscard">
                        <Grid ColumnDefinitions="32,16,*">
                            <Viewbox Width="26" Height="26" VerticalAlignment="Top"><Canvas Width="32" Height="32"><Path Stroke="{DynamicResource AccentGreenBrush}" StrokeThickness="1.8" StrokeJoin="Round" Data="M 17,29 L 5,29 L 5,3 L 19,3 L 27,11 L 27,17 M 19,3 L 19,11 L 27,11 M 9,15 L 21,15 M 9,20 L 15,20 M 9,25 L 14,25 M 20,22 L 20,20 C 20,16 26,16 26,20 L 26,22 M 18,22 L 28,22 L 28,30 L 18,30 Z M 23,25 L 23,27"/></Canvas></Viewbox>
                            <StackPanel Grid.Column="2" Spacing="8" IsEnabled="{Binding CanManageRemoteAccess}">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="Certificate" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border IsVisible="{Binding CertificateIsValid}" CornerRadius="14" Padding="10,4" Background="#235F2C"><StackPanel Orientation="Horizontal" Spacing="6"><mi:MaterialIcon Kind="ShieldCheck" Width="14" Height="14" Foreground="White"/><TextBlock Text="Valid" Foreground="White" FontSize="12"/></StackPanel></Border>
                                    <TextBlock IsVisible="{Binding CertificateIsValid}" Text="{Binding CertificateSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock IsVisible="{Binding !CertificateIsValid}" Text="{Binding CertificateSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Background="{DynamicResource SurfaceDarkBrush}">
                                    <Grid ColumnDefinitions="1.5*,24,*">
                                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderColorBrush}" Margin="0,2"/>
                                        <Grid ColumnDefinitions="140,*,32" RowDefinitions="Auto,Auto" RowSpacing="7">
                                            <TextBlock Text="SHA-256 Fingerprint" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CertificateFingerprint}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CertificateFingerprint}"/>
                                            <Button Grid.Column="2" Tag="fingerprint" Click="CopyConnectionValue_Click" Classes="footer" Width="28" Height="26" MinWidth="0" MinHeight="0" Padding="4" Margin="4,0,0,0" ToolTip.Tip="Click to copy"><mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/></Button>
                                            <TextBlock Grid.Row="1" Text="Serial Number" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CertificateSerial}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CertificateSerial}"/>
                                        </Grid>
                                        <Grid Grid.Column="2" ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                            <TextBlock Text="Expires On" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding CertificateExpiry}" FontSize="12"/>
                                            <TextBlock Grid.Row="1" Text="Issuer" FontSize="12"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CertificateIssuer}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CertificateIssuer}"/>
                                            <TextBlock Grid.Row="2" Text="Subject" FontSize="12"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CertificateSubject}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CertificateSubject}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button Command="{Binding ManageRemoteAccessCommand}" CommandParameter="regenerate-certificate" Classes="footer" Width="265" Padding="10,6" Margin="0"><StackPanel Orientation="Horizontal" Spacing="12"><mi:MaterialIcon Kind="Refresh" Width="22" Height="22" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Regenerate Certificate" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Create a new self-signed certificate." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel></Button>
                                    <Button Click="ImportCertificate_Click" Classes="footer" Width="240" Padding="10,6" Margin="0"><StackPanel Orientation="Horizontal" Spacing="12"><mi:MaterialIcon Kind="Upload" Width="22" Height="22" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Import Customer PFX" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Import an existing certificate (.pfx)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel></Button>
                                </StackPanel>
                                <TextBox IsVisible="{Binding HasTemporaryRemoteKey}" Text="{Binding NewRemoteKey}" IsReadOnly="True" Watermark="Temporary key if encrypted display storage fails."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settingscard">
                        <Grid ColumnDefinitions="32,16,*">
                            <mi:MaterialIcon Kind="LinkVariant" Width="28" Height="28" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="Connect This App" FontSize="14" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                    <TextBlock Text="Use the following information to connect this application to the MonitorAgent service." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </WrapPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ConnectFields}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Monitor points -->
            <Grid Margin="12,8,4,0" RowDefinitions="Auto,*"
                  IsVisible="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter='Monitor Points'}">
                <StackPanel Grid.Row="0" Margin="0,0,12,12" Spacing="18">
                    <Grid ColumnDefinitions="76,18,*" Margin="0,8,0,12"><Border Width="76" Height="76" CornerRadius="10" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" Background="{DynamicResource SurfaceDarkBrush}"><mi:MaterialIcon Kind="ChartBar" Width="44" Height="34" MinHeight="0" Foreground="{DynamicResource AccentGreenBrush}"/></Border><StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Monitor Points" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Manage monitor points, thresholds, and collection intervals for this device." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Grid>
                    <Border Classes="settingscard" Margin="0" Padding="16"><Grid ColumnDefinitions="180,12,*,12,180">
                        <Button Command="{Binding AddMonitorPointCommand}" Height="34" MinHeight="0" Background="{DynamicResource AccentGreenBrush}" Foreground="White" CornerRadius="6" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="12"><mi:MaterialIcon Kind="PlusCircleOutline" Width="18" Height="18"/><TextBlock Text="Add Monitor Point" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
                        <Border Grid.Column="2" Height="34" MinHeight="0" CornerRadius="6" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"><Grid ColumnDefinitions="32,*"><mi:MaterialIcon Kind="Magnify" Width="18" Height="18"/><TextBox Grid.Column="1" Text="{Binding MonitorPointSearch}" Watermark="Search monitor points..." BorderThickness="0" Background="Transparent" FontSize="12" VerticalContentAlignment="Center"/></Grid></Border>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding MonitorPointFilterOptions}" SelectedItem="{Binding MonitorPointTypeFilter}" Height="34" MinHeight="0" CornerRadius="6" Padding="10,4" FontSize="12" HorizontalAlignment="Stretch"/>
                    </Grid></Border>
                </StackPanel>
                <Border Grid.Row="1" Classes="settingscard" Margin="0,0,12,8" Padding="14"><Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="70,20,*" Margin="0,0,0,18"><Border Width="70" Height="68" CornerRadius="10" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"><mi:MaterialIcon Kind="FormatListBulleted" Width="40" Height="40" Foreground="{DynamicResource AccentGreenBrush}"/></Border><StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Configured Monitor Points" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="View and manage all monitor points for this device. Edit a monitor point to change its settings." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Grid>
                <controls:AppDataGrid Name="MonitorPointsGrid" Grid.Row="1" ItemsSource="{Binding FilteredMonitorPoints}" SelectedItem="{Binding SelectedMonitorPoint}"
                                      IsReadOnly="False" RowHeight="42" FontSize="13" BorderThickness="1" BorderBrush="{DynamicResource BorderColorBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding MonitorPointId}" Width="72"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="1.4*" MinWidth="100"/>
                        <DataGridTemplateColumn Header="Type" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox Classes="cell" ItemsSource="{Binding $parent[DataGrid].DataContext.MonitorPointTypes}"
                                              SelectedValueBinding="{Binding Type}" DisplayMemberBinding="{Binding Label}"
                                              SelectedValue="{Binding Type}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Device" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsDevice}">
                                        <controls:GlyphIcon Glyph="{Binding DeviceGlyph}" Size="16"
                                                         Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DeviceKindLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox Classes="cell" ItemsSource="{Binding $parent[DataGrid].DataContext.DeviceKinds}"
                                              SelectedValueBinding="{Binding Kind}" SelectedValue="{Binding DeviceKind}"
                                              IsVisible="{Binding IsDevice}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:GlyphIcon Glyph="{Binding Glyph}" Size="14"
                                                                     Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Application" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsApplication}">
                                        <Image Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"
                                               Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox Classes="cell" ItemsSource="{Binding $parent[DataGrid].DataContext.InstalledApplications}"
                                              SelectedValueBinding="{Binding ExecutablePath}" SelectedValue="{Binding ApplicationPath}"
                                              IsVisible="{Binding IsApplication}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="16" Height="16" Margin="0,0,6,0"
                                                           Source="{Binding IconBase64, Converter={StaticResource IconToImageConverter}}"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Database" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                    <Button Click="ConfigureDatabase_Click" Classes="footer" Margin="4,0" Padding="8,4"
                                            HorizontalAlignment="Left" IsVisible="{Binding IsDatabase}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"
                                                   Source="{Binding DatabaseLogo, Converter={StaticResource IconToImageConverter}}"/>
                                            <TextBlock Text="{Binding DatabaseSummary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="CopyPassword_Click" Content="Copy saved password" IsVisible="{Binding IsDatabase}" Classes="footer" Margin="4,0" Padding="8,4"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Address" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Classes="logo" Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                        <TextBlock Text="{Binding Address}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Address}" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Enabled" Width="80" SortMemberPath="Enabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Classes="grid" RenderTransformOrigin="50%,50%" RenderTransform="scale(0.95)" ToolTip.Tip="Check this monitor point" IsChecked="{Binding Enabled}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Short" Width="70" SortMemberPath="ShowInShortcut">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Classes="grid" RenderTransformOrigin="50%,50%" RenderTransform="scale(0.95)" ToolTip.Tip="Show this monitor point on the dashboard" IsChecked="{Binding ShowInShortcut}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Alert Level" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Classes="cell" Margin="4,0" ItemsSource="{Binding $parent[DataGrid].DataContext.AlertOptions}"
                                              SelectedValueBinding="{Binding Alert}" SelectedValue="{Binding Alert}"
                                              ItemTemplate="{StaticResource AlertItem}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Interval" Binding="{Binding IntervalSeconds}" Width="80"/>
                        <DataGridTemplateColumn Header="Actions" Width="120" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6"><Button Click="EditMonitorPoint_Click" Padding="6" MinWidth="0" ToolTip.Tip="Edit monitor point"><mi:MaterialIcon Kind="Pencil" Width="16" Height="16"/></Button><Button Click="SaveSettings_Click" Padding="6" MinWidth="0" ToolTip.Tip="Save changes"><mi:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/></Button><Button Classes="bin" ToolTip.Tip="Delete this monitor point"
                                            Command="{Binding $parent[DataGrid].DataContext.RemoveMonitorPointCommand}"
                                            CommandParameter="{Binding}"/></StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </controls:AppDataGrid>
                </Grid></Border>
            </Grid>

            <!-- Device specifications -->
            <ScrollViewer Margin="12,8,12,12" VerticalScrollBarVisibility="Auto" IsVisible="{Binding SelectedSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Conditions}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="84,20,*,24,340" Margin="0,8,0,12">
                        <Border Height="84" CornerRadius="12" Background="{DynamicResource SurfaceDarkBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"><mi:MaterialIcon Kind="FileDocumentOutline" Width="48" Height="48" Foreground="{DynamicResource AccentGreenBrush}"/></Border>
                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Device Specifications &amp; Alerts" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Configure minimum requirements and alert thresholds for this device. These values determine when MonitorAgent will trigger warnings or problems based on system performance and resource usage." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                        <Border Grid.Column="4" Classes="settingscard" Margin="0" Padding="14"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal" Spacing="10"><mi:MaterialIcon Kind="InformationOutline" Width="18" Height="18"/><TextBlock Text="How alerts work" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Minimum   — Required value for the metric." FontSize="11"/><TextBlock Text="● Warning   — Triggers at the warning threshold." FontSize="11" Foreground="{DynamicResource AccentYellowBrush}"/><TextBlock Text="● Problem   — Triggers at the problem threshold." FontSize="11" Foreground="{DynamicResource AccentRedBrush}"/><TextBlock Text="Alert Level   — Sets the notification level." FontSize="11"/></StackPanel></Border>
                    </Grid>
                    <Border Classes="settingscard" Margin="0"><StackPanel Spacing="14">
                        <Grid ColumnDefinitions="64,18,*"><Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1"><mi:MaterialIcon Kind="CogOutline" Width="40" Height="40" Foreground="{DynamicResource AccentGreenBrush}"/></Border><StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center"><TextBlock Text="Threshold Configuration" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Set minimum values and thresholds for each system component. Alerts will be triggered based on these settings." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderColorBrush}" Background="{DynamicResource SurfaceDarkBrush}" Padding="16,12"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><TextBlock Text="Metric" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Minimum" FontWeight="SemiBold"/><TextBlock Text="Required value" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="4" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="16" Height="16" Fill="{DynamicResource AccentYellowBrush}"/><TextBlock Text="Warning Threshold" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Trigger warning at" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="6" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="16" Height="16" Fill="{DynamicResource AccentRedBrush}"/><TextBlock Text="Problem Threshold" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Trigger problem at" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="8" Spacing="5"><TextBlock Text="Alert Level" FontWeight="SemiBold"/><TextBlock Text="Notification level" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Grid></Border><StackPanel><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="8,16"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><Grid ColumnDefinitions="42,16,*"><mi:MaterialIcon Kind="Chip" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="CPU" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Minimum number of CPU cores" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><ContentControl Grid.Column="2" VerticalAlignment="Center"><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource InputBrush}" Height="38"><Grid ColumnDefinitions="*,60"><TextBox Text="{Binding CpuMinCores}" BorderThickness="0" Background="Transparent" Padding="12,5" FontSize="13" VerticalContentAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="0,4,4,0"><TextBlock Text="cores" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid></Border></ContentControl><ContentControl Grid.Column="4" VerticalAlignment="Center"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,48"><NumericUpDown Classes="monitorcompact" Value="{Binding CpuWarningPercent}" Minimum="0" Maximum="2147483647" Height="38" MinHeight="0" FontSize="13" CornerRadius="5" Padding="0"/><TextBlock Grid.Column="1" Text="%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Grid></StackPanel></ContentControl><ContentControl Grid.Column="6" VerticalAlignment="Center"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,48"><NumericUpDown Classes="monitorcompact" Value="{Binding CpuProblemPercent}" Minimum="0" Maximum="2147483647" Height="38" MinHeight="0" FontSize="13" CornerRadius="5" Padding="0"/><TextBlock Grid.Column="1" Text="%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Grid></StackPanel></ContentControl><ContentControl Grid.Column="8" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding SpecAlertOptions}" SelectedValueBinding="{Binding Alert}" SelectedValue="{Binding CpuAlert}" ItemTemplate="{StaticResource AlertItem}" Height="38" CornerRadius="5"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="8,16"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><Grid ColumnDefinitions="42,16,*"><mi:MaterialIcon Kind="Memory" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="RAM" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Minimum amount of memory" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><ContentControl Grid.Column="2" VerticalAlignment="Center"><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource InputBrush}" Height="38"><Grid ColumnDefinitions="*,60"><TextBox Text="{Binding RamMinGb}" BorderThickness="0" Background="Transparent" Padding="12,5" FontSize="13" VerticalContentAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="0,4,4,0"><TextBlock Text="GB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid></Border></ContentControl><ContentControl Grid.Column="4" VerticalAlignment="Center"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,48"><NumericUpDown Classes="monitorcompact" Value="{Binding RamWarningPercent}" Minimum="0" Maximum="2147483647" Height="38" MinHeight="0" FontSize="13" CornerRadius="5" Padding="0"/><TextBlock Grid.Column="1" Text="%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Grid></StackPanel></ContentControl><ContentControl Grid.Column="6" VerticalAlignment="Center"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,48"><NumericUpDown Classes="monitorcompact" Value="{Binding RamProblemPercent}" Minimum="0" Maximum="2147483647" Height="38" MinHeight="0" FontSize="13" CornerRadius="5" Padding="0"/><TextBlock Grid.Column="1" Text="%" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Grid></StackPanel></ContentControl><ContentControl Grid.Column="8" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding SpecAlertOptions}" SelectedValueBinding="{Binding Alert}" SelectedValue="{Binding RamAlert}" ItemTemplate="{StaticResource AlertItem}" Height="38" CornerRadius="5"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="8,16"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><Grid ColumnDefinitions="42,16,*"><mi:MaterialIcon Kind="DatabaseOutline" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="Disk" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Minimum disk space (remaining)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><ContentControl Grid.Column="2" VerticalAlignment="Center"><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource InputBrush}" Height="38"><Grid ColumnDefinitions="*,60"><TextBox Text="{Binding DiskMinimum}" BorderThickness="0" Background="Transparent" Padding="12,5" FontSize="13" VerticalContentAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="0,4,4,0"><TextBlock Text="GB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid></Border></ContentControl><ContentControl Grid.Column="4" VerticalAlignment="Center"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,48"><NumericUpDown Classes="monitorcompact" Value="{Binding DiskRemainingWarning}" Minimum="0" Maximum="2147483647" Height="38" MinHeight="0" FontSize="13" CornerRadius="5" Padding="0"/><ComboBox Grid.Column="1" ItemsSource="{Binding DiskUnitOptions}" SelectedItem="{Binding DiskRemainingWarningUnit}" Height="38" MinHeight="0" Margin="0" Padding="4,0" BorderThickness="0" FontSize="11"/></Grid><TextBlock Text="Remaining space" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="6" VerticalAlignment="Center"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,48"><NumericUpDown Classes="monitorcompact" Value="{Binding DiskRemainingProblem}" Minimum="0" Maximum="2147483647" Height="38" MinHeight="0" FontSize="13" CornerRadius="5" Padding="0"/><ComboBox Grid.Column="1" ItemsSource="{Binding DiskUnitOptions}" SelectedItem="{Binding DiskRemainingProblemUnit}" Height="38" MinHeight="0" Margin="0" Padding="4,0" BorderThickness="0" FontSize="11"/></Grid><TextBlock Text="Remaining space" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="8" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding SpecAlertOptions}" SelectedValueBinding="{Binding Alert}" SelectedValue="{Binding DiskAlert}" ItemTemplate="{StaticResource AlertItem}" Height="38" CornerRadius="5"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="8,16"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><Grid ColumnDefinitions="42,16,*"><mi:MaterialIcon Kind="Web" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="Internet" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Minimum internet speed (download)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><ContentControl Grid.Column="2" VerticalAlignment="Center"><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource InputBrush}" Height="38"><Grid ColumnDefinitions="*,60"><TextBox Text="{Binding InternetMinKbps}" BorderThickness="0" Background="Transparent" Padding="12,5" FontSize="13" VerticalContentAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="0,4,4,0"><TextBlock Text="Kbps" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid></Border></ContentControl><ContentControl Grid.Column="4" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="6" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="8" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding YesNoOptions}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Label}" SelectedValue="{Binding InternetNotify}" Height="38" CornerRadius="5"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="8,16"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><Grid ColumnDefinitions="42,16,*"><mi:MaterialIcon Kind="Download" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="Download" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Minimum download speed" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><ContentControl Grid.Column="2" VerticalAlignment="Center"><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource InputBrush}" Height="38"><Grid ColumnDefinitions="*,60"><TextBox Text="{Binding DownloadMinKbps}" BorderThickness="0" Background="Transparent" Padding="12,5" FontSize="13" VerticalContentAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="0,4,4,0"><TextBlock Text="Kbps" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid></Border></ContentControl><ContentControl Grid.Column="4" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="6" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="8" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding YesNoOptions}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Label}" SelectedValue="{Binding DownloadNotify}" Height="38" CornerRadius="5"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="8,16"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><Grid ColumnDefinitions="42,16,*"><mi:MaterialIcon Kind="Upload" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="Upload" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Minimum upload speed" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><ContentControl Grid.Column="2" VerticalAlignment="Center"><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource InputBrush}" Height="38"><Grid ColumnDefinitions="*,60"><TextBox Text="{Binding UploadMinKbps}" BorderThickness="0" Background="Transparent" Padding="12,5" FontSize="13" VerticalContentAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="0,4,4,0"><TextBlock Text="Kbps" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Border></Grid></Border></ContentControl><ContentControl Grid.Column="4" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="6" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="8" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding YesNoOptions}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Label}" SelectedValue="{Binding UploadNotify}" Height="38" CornerRadius="5"/></ContentControl></Grid></Border><Border BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,0,1" Padding="8,16"><Grid ColumnDefinitions="1.5*,24,*,28,*,28,*,28,0.8*"><Grid ColumnDefinitions="42,16,*"><mi:MaterialIcon Kind="MicrosoftWindows" Width="32" Height="32" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="Operating system" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Minimum required operating system" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><ContentControl Grid.Column="2" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding OperatingSystemOptions}" SelectedItem="{Binding RequiredOperatingSystem}" Height="38" CornerRadius="5"/></ContentControl><ContentControl Grid.Column="4" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="6" VerticalAlignment="Center"><StackPanel Spacing="4"><TextBlock Text="—"/><TextBlock Text="Not applicable" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ContentControl><ContentControl Grid.Column="8" VerticalAlignment="Center"><ComboBox Classes="field spec" ItemsSource="{Binding YesNoOptions}" SelectedValueBinding="{Binding Value}" DisplayMemberBinding="{Binding Label}" SelectedValue="{Binding OsNotify}" Height="38" CornerRadius="5"/></ContentControl></Grid></Border></StackPanel></StackPanel></Border></StackPanel></ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
