<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MonitorAgent.Desktop.Views"
        xmlns:controls="using:MonitorAgent.Desktop.Controls"
        x:Class="MonitorAgent.Desktop.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/monitoragent.ico"
        Width="1280"
        Height="780"
        MinWidth="1000"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="36">
    <Window.Styles>
        <Style Selector="ToggleButton.pin">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}"/>
            <Setter Property="ToolTip.Tip" Value="Auto hide is ON (hides when the mouse leaves). Click to keep it open"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" Background="{DynamicResource ButtonBrush}" CornerRadius="5"
                            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                        <Path Name="PinIcon" Width="14" Height="14" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}" RenderTransform="rotate(45deg)"
                              Data="M 5,0 L 11,0 L 11,1.5 L 10,1.5 L 10,6 L 13,9 L 13,10.5 L 8.75,10.5 L 8.75,16 L 7.25,16 L 7.25,10.5 L 3,10.5 L 3,9 L 6,6 L 6,1.5 L 5,1.5 Z"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.pin:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="ToolTip.Tip" Value="Pinned open. Click to turn on auto hide"/>
        </Style>
        <Style Selector="ToggleButton.pin:checked /template/ Path#PinIcon">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>
        <Style Selector="ToggleButton.pin:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>

        <Style Selector="Border.strip">
            <Setter Property="Background" Value="{DynamicResource SurfaceDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.strip:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
        </Style>

        <Style Selector="Button.titlebar">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.titlebar:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.titlebar:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <Style Selector="Button.chip">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Chip" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.chip:pointerover /template/ Border#Chip">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="Button.chip.selected /template/ Border#Chip">
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentGreenBrush}"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="Root" RowDefinitions="36,*,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceDarkBrush}"
                PointerPressed="TitleBar_PointerPressed" DoubleTapped="TitleBar_DoubleTapped">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ResetLayoutButton" Classes="titlebar" Click="ResetLayout_Click"
                            ToolTip.Tip="Reset the dashboard and panels to your default layout (right-click for more)">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Reset to my default" Click="ResetLayout_Click"/>
                                <MenuItem Header="Save current layout as my default" Click="SaveDefaultLayout_Click"/>
                                <Separator/>
                                <MenuItem Header="Reset to original layout" Click="ResetOriginalLayout_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <controls:GlyphIcon Glyph="&#xE72C;" Size="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Reset layout" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="CaptionButtons" Orientation="Horizontal">
                        <Button Classes="caption" Content="─" Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Classes="caption" Content="☐" Click="Maximize_Click"/>
                        <Button Classes="caption close" Content="✕" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="TitleLeft" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="titlebar" Margin="4,0,0,0" Padding="9,0" Click="ToggleMenu_Click"
                            ToolTip.Tip="Show / auto hide the menu">
                        <controls:GlyphIcon Glyph="&#xE700;" Size="14"/>
                    </Button>
                    <Button Classes="titlebar" Margin="2,0,0,0" Padding="9,0"
                            Command="{Binding GoBackCommand}" ToolTip.Tip="{Binding BackToolTip}"
                            ToolTip.ShowOnDisabled="True">
                        <Path Width="14" Height="12" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                              Data="M 6,0 L 7.4,1.4 L 3.8,5 L 14,5 L 14,7 L 3.8,7 L 7.4,10.6 L 6,12 L 0,6 Z"/>
                    </Button>
                    <Image Width="18" Height="18" Margin="6,0,8,0" Source="/Assets/monitoragent.png"/>
                    <TextBlock Text="{Binding WindowTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="NavStrip" Grid.Row="1" Grid.Column="0" Classes="strip" IsVisible="False"
                BorderThickness="0,0,1,0" ToolTip.Tip="Menu">
            <controls:GlyphIcon Glyph="&#xE76C;" Size="11" HorizontalAlignment="Center"/>
        </Border>

        <Border x:Name="NavPanel" Grid.Row="1" Grid.Column="0" Width="92" HorizontalAlignment="Left" ZIndex="20"
                Background="{DynamicResource SurfaceDarkBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <StackPanel Margin="0,8,0,8">
                <Button Classes="nav" Content="Dashboard" Tag="&#xE80F;" 
                             Command="{Binding SelectTabCommand}" CommandParameter="Dashboard"
                             Classes.selected="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter='Dashboard'}"/>
                <Button Classes="nav" Content="Monitor Points" Tag="&#xE707;" 
                             Command="{Binding SelectTabCommand}" CommandParameter="Monitor Points"
                             Classes.selected="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter='Monitor Points'}"/>
                <Button Classes="nav" Content="Reports" Tag="&#xE9D2;" 
                             Command="{Binding SelectTabCommand}" CommandParameter="Reports"
                             Classes.selected="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter='Reports'}"/>
                <Button Classes="nav" Content="Settings" Tag="&#xE713;" 
                             Command="{Binding SelectTabCommand}" CommandParameter="Settings"
                             Classes.selected="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter='Settings'}"/>
                <Button Classes="nav" Content="About" Tag="&#xE946;" 
                             Command="{Binding SelectTabCommand}" CommandParameter="About"
                             Classes.selected="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter='About'}"/>
            </StackPanel>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1" Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="StatusStrip" Grid.Row="0" Classes="strip" IsVisible="False"
                    BorderThickness="0,0,0,1" ToolTip.Tip="Service Status">
                <controls:GlyphIcon Glyph="&#xE70D;" Size="11" HorizontalAlignment="Center"/>
            </Border>

            <Border x:Name="StatusPanel" Grid.Row="0" VerticalAlignment="Top" ZIndex="20"
                    Background="{DynamicResource SurfaceDarkAltBrush}"
                    CornerRadius="5" Margin="8,6" Padding="12,8"
                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <ToggleButton x:Name="StatusPin" Classes="pin" IsChecked="True" ZIndex="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0"/>
                    <Grid x:Name="StatusGrid" ColumnDefinitions="Auto,Auto,1.65*,Auto,0.75*">
                        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top" MaxWidth="280">
                            <TextBlock Text="Service Status" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="24" Height="24" Margin="0,0,8,0">
                                    <Ellipse Fill="{Binding ServiceRunning, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                                    <controls:GlyphIcon Glyph="&#xE73E;" Size="12" Foreground="White" HorizontalAlignment="Center" IsVisible="{Binding ServiceRunning}"/>
                                    <controls:GlyphIcon Glyph="&#xE711;" Size="12" Foreground="White" HorizontalAlignment="Center" IsVisible="{Binding !ServiceRunning}"/>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AgentStatus, StringFormat='Service: {0}'}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"
                                               Text="{Binding Settings.DeviceLabel, StringFormat='Device: {0}'}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"
                                               Text="{Binding AgentVersion}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                <Grid Width="24" Height="24" Margin="0,0,8,0">
                                    <Ellipse Fill="{Binding InternetConnected, Converter={StaticResource BoolToStatusBrushConverter}}"/>
                                    <controls:GlyphIcon Glyph="&#xE701;" Size="12" Foreground="White" HorizontalAlignment="Center"/>
                                    <controls:GlyphIcon Glyph="&#xE711;" Size="9" Foreground="White"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                                                     IsVisible="{Binding !InternetConnected}"/>
                                </Grid>
                                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding InternetStatus}"/>
                            </StackPanel>
                            <Border Background="{DynamicResource SurfaceDarkBrush}" CornerRadius="5" Padding="8,4" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Uptime, StringFormat='Uptime: {0}'}"/>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Margin="12,0,0,0" Text="{Binding RamTotalText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="{StaticResource Hairline}" Fill="{DynamicResource BorderColorBrush}" Margin="10,2"
                                   IsVisible="{Binding HasMonitorPoints}"/>

                        <DockPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Top" IsVisible="{Binding HasMonitorPoints}">
                            <TextBlock DockPanel.Dock="Top" Text="Monitor Points" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <RepeatButton Grid.Column="0" Classes="chipnav" Click="MonitorPointsScrollLeft" VerticalAlignment="Center">
                                    <Path Width="10" Height="16" Stretch="Uniform" Fill="White" Data="M 12,0 L 0,8 L 12,16 Z"/>
                                </RepeatButton>
                                <ScrollViewer x:Name="MonitorPointsSlider" Grid.Column="1" Margin="4,0"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              PointerWheelChanged="MonitorPointsSlider_PointerWheelChanged">
                                    <ItemsControl ItemsSource="{Binding DashboardMonitorPoints}" HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="chip" Classes.selected="{Binding IsSelected}"
                                                        Command="{Binding $parent[Window].DataContext.SelectMonitorPointCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <Grid Width="52" Height="52" HorizontalAlignment="Center">
                                                            <Ellipse Width="52" Height="52" Opacity="0.22"
                                                                     Fill="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"/>
                                                            <Ellipse Width="46" Height="46" Fill="{DynamicResource ChipFillBrush}"
                                                                     Stroke="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"
                                                                     StrokeThickness="2"/>
                                                            <controls:GlyphIcon Glyph="{Binding Glyph}" Size="20" HorizontalAlignment="Center"
                                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                                             IsVisible="{Binding #PointLogo.Source, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                            <Image x:Name="PointLogo" Classes="logo" Width="28" Height="28" Margin="0"
                                                                   Source="{Binding Icon, Converter={StaticResource IconToImageConverter}}"/>
                                                        </Grid>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="0,4,0,3"
                                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Center"
                                                                 Fill="{Binding Status, Converter={StaticResource HealthToBrushConverter}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <RepeatButton Grid.Column="2" Classes="chipnav" Click="MonitorPointsScrollRight" VerticalAlignment="Center">
                                    <Path Width="10" Height="16" Stretch="Uniform" Fill="White" Data="M 0,0 L 12,8 L 0,16 Z"/>
                                </RepeatButton>
                            </Grid>
                        </DockPanel>

                        <Rectangle Grid.Column="3" Width="{StaticResource Hairline}" Fill="{DynamicResource BorderColorBrush}" Margin="10,2"
                                   IsVisible="{Binding ShowNotifications}"/>

                        <DockPanel Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Top" IsVisible="{Binding ShowNotifications}">
                            <TextBlock DockPanel.Dock="Top" Text="Messages &amp; Issues Board" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource IssueBoardBrush}" CornerRadius="6" Padding="8,6"
                                    BorderBrush="{DynamicResource IssueBoardBorderBrush}" BorderThickness="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Current Issues" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72">
                                        <Grid>
                                            <TextBlock Text="No notifications right now." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       IsVisible="{Binding !HasCurrentIssues}"/>
                                            <ItemsControl ItemsSource="{Binding CurrentIssues}" IsVisible="{Binding HasCurrentIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                            <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource IssueTextBrush}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <views:DashboardView x:Name="Dashboard"
                                     IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Dashboard}"/>
                <views:MonitorPointsView
                    IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Monitor Points}"/>
                <views:SettingsView
                    IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Settings}"/>
                <views:ReportsView
                    IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=Reports}"/>
                <views:AboutView
                    IsVisible="{Binding SelectedTab, Converter={StaticResource EqualsConverter}, ConverterParameter=About}"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource SurfaceDarkAltBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,1,0,0"/>
    </Grid>
</Window>
