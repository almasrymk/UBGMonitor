<UserControl x:Class="MonitorAgent.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MonitorAgent.UI.Controls"
             xmlns:views="clr-namespace:MonitorAgent.UI.Views">
    <UserControl.Resources>
        <Style x:Key="ReportTypeItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="3,0,0,0" CornerRadius="4" Padding="12,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Good">
                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Bad">
                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetricChange" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Change}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeStatus}" Value="Good">
                    <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeStatus}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChangeStatus}" Value="Bad">
                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,8,12,10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceDarkAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}"/>
            <Setter Property="BorderThickness" Value="1,3,1,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Good">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentYellowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Bad">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ChartCard">
            <Border Margin="4" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource SurfaceDarkAltBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding Legend}" Margin="0,3,0,4" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Grid Width="16" Height="10" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Rectangle Height="3" Fill="{Binding Brush}">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dashed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Box}" Value="True">
                                                            <Setter Property="Height" Value="10"/>
                                                            <Setter Property="Width" Value="10"/>
                                                            <Setter Property="RadiusX" Value="2"/>
                                                            <Setter Property="RadiusY" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <Line X1="0" X2="16" Y1="5" Y2="5" Stroke="{Binding Brush}" StrokeThickness="2" StrokeDashArray="2 1.5"
                                              Visibility="{Binding Dashed, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:ReportChartControl Chart="{Binding Chart}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel DataContext="{Binding Reports}" Margin="8,4,16,12">
        <Border DockPanel.Dock="Left" Width="230"
                Background="{DynamicResource SurfaceDarkBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="0,0,1,0"
                Margin="0,0,12,0" Padding="8">
            <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ReportTypeItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsDetails, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="About" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Style="{StaticResource FieldCombo}" Width="230" Margin="0" VerticalAlignment="Center"
                              ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                              ToolTip="What the details report is about">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" FontSize="10" Margin="10,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="Period" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox Style="{StaticResource FieldCombo}" Width="140" Margin="0,0,12,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                            Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding CustomFrom}" Width="120" VerticalAlignment="Center"/>
                    <TextBlock Text="To" VerticalAlignment="Center" Margin="10,0,6,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <DatePicker SelectedDate="{Binding CustomTo}" Width="120" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Generate" Command="{Binding GenerateCommand}" Style="{StaticResource AccentFooterButton}"
                        Padding="18,6" Margin="0,0,8,0" ToolTip="Build the report for the chosen period"/>
                <Button Content="Export HTML / PDF" Command="{Binding ExportHtmlCommand}" Style="{StaticResource FooterButton}"
                        Padding="14,6" Margin="0,0,8,0" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Save the report as a web page and open it. Use Print / Save as PDF in the browser for a PDF."/>
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource FooterButton}"
                        Padding="14,6" Margin="0,0,12,0" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Save the report tables as a CSV file for Excel"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </WrapPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="18,14,18,20">
                        <TextBlock Text="{Binding ReportTitle}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding ReportDescription}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ReportPeriod}" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,22,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Nothing to show for this period." Margin="0,4,0,0" FontStyle="Italic"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                                        <ItemsControl ItemsSource="{Binding Metrics}" Margin="-4,8,0,0"
                                                      Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MetricCard}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Value}" Margin="0,4,0,0"
                                                                       Style="{StaticResource MetricValue}"/>
                                                            <TextBlock Text="{Binding Change}" Style="{StaticResource MetricChange}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding ChartRows}" Margin="-4,6,-4,0" Focusable="False"
                                                      Visibility="{Binding HasCharts, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding}" Focusable="False"
                                                                  ItemTemplate="{StaticResource ChartCard}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Double-click a row to open its detailed report." FontSize="11" Margin="0,10,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"
                                                   Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}"/>
                                        <DataGrid Margin="0,4,0,0" MaxHeight="420" IsReadOnly="True"
                                                  HeadersVisibility="Column" CanUserAddRows="False"
                                                  ItemsSource="{Binding Rows}"
                                                  views:ReportTable.Columns="{Binding Columns}"
                                                  PreviewMouseWheel="Table_PreviewMouseWheel"
                                                  MouseDoubleClick="Table_MouseDoubleClick"
                                                  Visibility="{Binding HasTable, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="24" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasReport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
