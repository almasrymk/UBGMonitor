{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/ProgramData/ClientAgent/logs/agent-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Agent": {
    "AgentId": "",
    "Version": "1.0.0"
  },
  "Routing": {
    "MadkhalServerUrl": "http://madkhal.local:8080",
    "CentralApiUrl": "https://api.central.local",
    "MadkhalTimeoutSeconds": 5,
    "CentralTimeoutSeconds": 15
  },
  "LocalApi": {
    "Port": 5050
  },
  "Monitoring": {
    "ResourceIntervalSeconds": 30,
    "DeviceIntervalSeconds": 15,
    "DatabaseIntervalSeconds": 30,
    "MadkhalIntervalSeconds": 20
  }
}
