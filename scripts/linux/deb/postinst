#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    getent group monitoragent >/dev/null || groupadd --system monitoragent
    getent group monitoragent-admin >/dev/null || groupadd --system monitoragent-admin
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
        usermod -aG monitoragent-admin,monitoragent "$SUDO_USER"
        echo "Sign out and in to apply MonitorAgent group membership."
    fi
    umask 0077
    mkdir -p /var/lib/monitoragent /var/log/monitoragent
    chown -R root:root /opt/monitoragent /opt/monitoragent-desktop /var/lib/monitoragent /var/log/monitoragent
    chmod -R go+rX,go-w /opt/monitoragent /opt/monitoragent-desktop
    chmod 700 /var/lib/monitoragent
    chmod 750 /var/log/monitoragent
    find /var/lib/monitoragent -type f -exec chmod 600 {} +
    ln -sf /opt/monitoragent-desktop/MonitorAgent /usr/bin/monitoragent

    systemctl daemon-reload
    systemctl enable monitoragent >/dev/null 2>&1 || true
    systemctl restart monitoragent || true

    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
fi

exit 0
